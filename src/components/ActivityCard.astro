---
import { getCollection } from 'astro:content';
import { buildPublicActivity } from '../lib/public-activity.mjs';
const [worklog, newsletter, insights] = await Promise.all([getCollection('worklog'), getCollection('newsletter'), getCollection('insights')]);
const activity = buildPublicActivity({worklog, newsletter, insights});

const archiveTotal = activity.totals.worklog + activity.totals.newsletter + activity.totals.insights;
const recent = activity.recent.slice(0, 4);
const metrics = [
  { label: '최근 7일', value: activity.totals.last_7_days, detail: '공개 기록' },
  { label: '최근 30일', value: activity.totals.last_30_days, detail: '공개 기록' },
  { label: '전체 아카이브', value: archiveTotal, detail: '제목·날짜 기준' },
];
---
<section class="activity-section" aria-labelledby="activity-title">
  <div class="activity-head">
    <div>
      <p class="activity-kicker mb-eyebrow">공개 활동</p>
      <h2 id="activity-title">최근 공개 활동</h2>
    </div>
    <p>
      작업일지·뉴스레터·인사이트에 실제로 공개된 기록만 모았어요.
      새 글을 발행할 때 집계도 함께 갱신해요.
    </p>
  </div>

  <div class="activity-body">
    <dl class="activity-metrics" aria-label="공개 활동 집계">
      {metrics.map((metric) => (
        <div>
          <dt>{metric.label}</dt>
          <dd>{metric.value}</dd>
          <span>{metric.detail}</span>
        </div>
      ))}
    </dl>

    <div class="activity-recent">
      <div class="activity-recent-head">
        <h3>최근 기록</h3>
        <span>{activity.as_of} 기준</span>
      </div>
      <ul>
        {recent.map((item) => (
          <li>
            <a href={item.href}>
              <span class="activity-meta">{item.label} · {item.date}</span>
              <strong>{item.title}</strong>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="activity-privacy">
    공개 범위: 집계와 허용된 공개 제목만 · 원문 로그, 입력 내용, 내부 경로, 기기 정보는 수집하지 않아요.
  </p>
</section>

<style>
  /* T-261024-058: 눈썹 글은 공용 부품(.mb-eyebrow), 간격·글자 크기는 공용 톤 값(--tone-*·작업장 --text-*)만 쓴다 — 직접 숫자 0. */
  .activity-section {
    padding: var(--tone-space-5) 0 0;
    border-top: 1px solid var(--border);
  }

  .activity-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);
    gap: var(--tone-space-5);
    align-items: end;
    margin-bottom: var(--tone-space-4);
  }

  .activity-head h2 {
    font-size: var(--text-h2);
    line-height: var(--leading-h1);
  }

  .activity-head > p {
    color: var(--fg-dim);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    word-break: keep-all;
  }

  .activity-body {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: var(--tone-space-6);
  }

  .activity-metrics {
    border-top: 1px solid var(--border);
  }

  .activity-metrics div {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr) auto;
    gap: var(--tone-space-3);
    align-items: baseline;
    min-height: var(--tone-control-height);
    padding: var(--tone-space-3) 0;
    border-bottom: 1px solid var(--border);
  }

  .activity-metrics dt,
  .activity-metrics span,
  .activity-recent-head span,
  .activity-meta {
    color: var(--fg-mute);
    font-size: var(--text-meta);
  }

  .activity-metrics dt,
  .activity-metrics dd,
  .activity-recent-head span {
    font-family: var(--tone-font);
  }

  .activity-metrics dd {
    color: var(--fg);
    font-size: var(--text-h3);
    font-weight: var(--tone-weight-bold);
  }

  .activity-metrics span {
    white-space: nowrap;
  }

  .activity-recent {
    min-width: 0;
    border-top: 1px solid var(--border);
  }

  .activity-recent-head {
    display: flex;
    justify-content: space-between;
    gap: var(--tone-space-3);
    align-items: baseline;
    min-height: var(--tone-control-height);
    padding: var(--tone-space-3) 0;
    border-bottom: 1px solid var(--border);
  }

  .activity-recent-head h3 {
    font-size: var(--text-h3);
  }

  .activity-recent ul {
    list-style: none;
  }

  .activity-recent li {
    border-bottom: 1px solid var(--border);
  }

  .activity-recent a {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: var(--tone-space-3);
    align-items: baseline;
    min-height: var(--tone-control-height);
    padding: var(--tone-space-3) 0;
    color: var(--fg);
    text-decoration: none;
  }

  .activity-recent a:hover {
    background: var(--bg-elev);
    color: var(--fg);
  }

  .activity-recent strong {
    min-width: 0;
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .activity-privacy {
    margin-top: var(--tone-space-3);
    color: var(--fg-mute);
    font-size: var(--text-meta);
    line-height: var(--leading-desc);
  }

  @media (max-width: 820px) {
    .activity-head,
    .activity-body {
      grid-template-columns: 1fr;
    }

    .activity-body {
      gap: var(--tone-space-5);
    }
  }

  @media (max-width: 560px) {
    .activity-metrics div,
    .activity-recent a {
      grid-template-columns: 1fr;
      gap: var(--tone-space-1);
    }

    .activity-metrics span {
      white-space: normal;
    }
  }
</style>

---
interface Post {
  id: string;
  data: { title: string; date: string; summary?: string; version?: string };
}
const {
  posts,
  base,
  title,
  eyebrow,
  description,
  unit = "편",
} = Astro.props as {
  posts: Post[];
  base: string;
  title: string;
  eyebrow: string;
  description: string;
  unit?: string;
};
const months = new Map<string, Post[]>();
posts.forEach((post) => {
  const month = post.data.date.slice(0, 7);
  months.set(month, [...(months.get(month) ?? []), post]);
});
const ep = (post: Post) => post.data.version?.match(/^ep(\d+)$/i)?.[1];
---

<section class="archive-intro" aria-labelledby="page-title">
  <div>
    <p class="eyebrow">{eyebrow}</p><h1 id="page-title">
      {title}<span>.</span>
    </h1><p class="lead">{description}</p>
  </div><div class="archive-total">
    <strong>{posts.length}</strong><span
      >{unit}의 기록,<br />그리고 다음 이야기.</span>
  </div>
</section>
<section class="latest-stories" aria-labelledby="latest-title">
  <div class="section-head">
    <h2 id="latest-title">가장 최근의 이야기</h2><p>
      작성일 기준으로 읽어요. 글 속 도구·가격·운영 상태는 당시의 기록이에요.
    </p>
  </div><div class="story-grid">
    {
      posts.slice(0, 3).map((post, index) => (
        <a class={`story-card story-${index}`} href={`${base}/${post.id}/`}>
          <span class="story-top" data-story-meta>
            <time datetime={post.data.date}>{post.data.date.replaceAll('-', '.')}</time>
            <span>{ep(post) ? `EP.${ep(post)}` : `0${index + 1}`}</span>
          </span>
          <h3>{post.data.title}</h3>
          {post.data.summary && <p>{post.data.summary}</p>}
          <span class="story-read">
            이야기 읽기 <b aria-hidden="true">↗</b>
          </span>
        </a>
      ))
    }
  </div>
</section>
<section class="archive-browse" data-archive aria-labelledby="archive-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">전체 기록</p><h2 id="archive-title">
        차곡차곡 쌓인 기록
      </h2>
    </div><label class="archive-search" data-archive-controls hidden
      ><span class="sr-only">{title} 검색</span><input
        type="search"
        placeholder="제목·요약·날짜로 찾기"
        data-archive-search
      /><span aria-hidden="true">⌕</span></label>
  </div><p
    class="search-count"
    data-archive-count
    role="status"
    aria-live="polite"
  >
    전체 {posts.length}{unit}
  </p>
  {
    Array.from(months.entries()).map(([month, entries]) => (
      <section class="archive-month" data-archive-month aria-label={month}>
        <>
          <header>
            <h3>
              {month.replace("-", ".")}
              <span>
                {entries.length}
                {unit}
              </span>
            </h3>
          </header>
          <ol>
            {entries.map((post) => (
              <li data-archive-item data-search={[post.data.title, post.data.summary, post.data.date, post.data.version].filter(Boolean).join(" ")}>
                <a href={`${base}/${post.id}/`}>
                  <time datetime={post.data.date}>
                    {post.data.date.slice(5).replace("-", ".")}
                  </time>
                  <span>{post.data.title}</span>
                  {post.data.version && <small>{ep(post) ? `EP.${ep(post)}` : post.data.version}</small>}
                  <b aria-hidden="true">↗</b>
                </a>
              </li>
            ))}
          </ol>
        </>
      </section>
    ))
  }
  <div class="archive-empty" data-archive-empty hidden>
    <h3>일치하는 기록이 없어요.</h3><p>
      짧은 검색어나 다른 제목으로 다시 찾아보세요.
    </p><button class="button" type="button" data-archive-reset
      >전체 기록 보기</button>
  </div>
</section>
<script>
  import { matchesSearch } from "../lib/workshop-search.mjs";
  document.querySelectorAll<HTMLElement>("[data-archive]").forEach((root) => {
    const controls = root.querySelector<HTMLElement>("[data-archive-controls]");
    if (controls) controls.hidden = false;
    const input = root.querySelector<HTMLInputElement>("[data-archive-search]");
    const rows = [...root.querySelectorAll<HTMLElement>("[data-archive-item]")];
    const groups = [
      ...root.querySelectorAll<HTMLElement>("[data-archive-month]"),
    ];
    const count = root.querySelector("[data-archive-count]");
    const empty = root.querySelector<HTMLElement>("[data-archive-empty]");
    const update = () => {
      const query = input?.value ?? "";
      let visible = 0;
      rows.forEach((row) => {
        row.hidden = !matchesSearch(row.dataset.search ?? "", query);
        if (!row.hidden) visible++;
      });
      groups.forEach((group) => {
        group.hidden = ![
          ...group.querySelectorAll<HTMLElement>("[data-archive-item]"),
        ].some((row) => !row.hidden);
      });
      if (count) count.textContent = `${visible}개의 기록`;
      if (empty) empty.hidden = visible !== 0;
    };
    input?.addEventListener("input", update);
    root
      .querySelector("[data-archive-reset]")
      ?.addEventListener("click", () => {
        if (input) input.value = "";
        update();
        input?.focus();
      });
  });
</script>
<style>
  .archive-intro {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--tone-section-gap);
    align-items: end;
    padding: var(--tone-card-padding) 0 var(--tone-section-gap);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--tone-section-gap);
  }
  /* T-261024-060: h1 크기·자간은 공용 studio-page.css 가 이김 — 죽은 선언 삭제 */
  .archive-intro h1 span {
    color: var(--accent);
  }
  .archive-intro .lead {
    font-size: var(--tone-body-size);
    max-width: 56ch;
    margin-top: var(--tone-space-4);
  }
  .archive-total {
    display: flex;
    align-items: center;
    gap: var(--tone-card-padding);
    background: var(--bg-elev);
    padding: var(--tone-space-4) var(--tone-space-5);
    border-radius: var(--tone-radius-card);
  }
  .archive-total strong {
    font: 54px/1 Georgia, serif; /* tone:fixed: Georgia 합계 디스플레이(의장) */
    color: var(--accent);
  }
  .archive-total span {
    font-size: var(--tone-caption-size);
    color: var(--fg-mute);
    line-height: 1.8;
  }
  .latest-stories {
    margin-bottom: var(--tone-section-gap);
  }
  .story-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tone-card-padding);
  }
  .story-card {
    display: flex;
    flex-direction: column;
    min-height: 275px; /* tone:fixed: 스토리 카드 고정 높이(의장) */
    padding: var(--tone-space-4);
    border: 1px solid var(--border);
    border-radius: var(--tone-radius-card);
    background: var(--accent-bg);
    text-decoration: none;
    transition: transform 0.2s;
  }
  .story-card:hover {
    transform: translateY(-4px);
  }
  .story-1 {
    background: var(--accent-bg);
  }
  .story-2 {
    background: var(--accent-bg);
  }
  .story-top {
    display: flex;
    justify-content: space-between;
    gap: var(--tone-space-3);
    font: 10px var(--mono); /* tone:fixed: 모노 마이크로 라벨(의장) */
    color: var(--fg-dim);
    margin-bottom: var(--tone-space-5);
  }
  /* T-261024-060: 카드 h3 크기는 공용이 이김 — 죽은 선언 삭제 */
  .story-card p {
    font-size: var(--tone-caption-size);
    margin-top: var(--tone-space-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .story-read {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--tone-space-4);
    font-size: var(--tone-caption-size);
    color: var(--fg-dim);
  }
  .story-read b {
    font-size: var(--tone-title-size);
    font-weight: 400;
  }
  .archive-browse > .section-head {
    align-items: center;
  }
  .archive-search {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--tone-radius-control);
    background: var(--bg-elev);
    padding: var(--tone-space-2) var(--tone-space-3);
    gap: var(--tone-space-3);
  }
  .archive-search input {
    width: 225px;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: var(--tone-caption-size);
    outline: none;
    color: var(--fg);
  }
  .archive-search:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .search-count {
    font: 11px var(--mono); /* tone:fixed: 모노 마이크로 라벨(의장) */
    margin: 0 0 var(--tone-space-3);
    color: var(--fg-mute);
  }
  .archive-month {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: var(--tone-space-5);
    border-top: 1px solid var(--border);
    padding-top: var(--tone-space-2);
    margin-top: var(--tone-space-4);
  }
  .archive-month h3 {
    /* T-261024-060: 크기는 공용(main#main-content, id)이 이기지만 글꼴은 스코프 특이도로 살아 있다 */
    font: 23px/1.5 Georgia, serif; /* tone:fixed: Georgia 월 제목 글꼴(크기 23px 는 공용 20px 가 이김) */
    padding: var(--tone-space-3) 0;
  }
  .archive-month h3 span {
    display: block;
    font: 10px var(--mono); /* tone:fixed: 모노 마이크로 라벨(의장) */
    color: var(--fg-mute);
    margin-top: var(--tone-space-2);
  }
  .archive-month ol {
    list-style: none;
  }
  .archive-month li {
    border-bottom: 1px solid var(--border-soft);
  }
  .archive-month a {
    display: flex;
    gap: var(--tone-card-padding);
    align-items: baseline;
    padding: var(--tone-card-padding) 0;
    text-decoration: none;
    font-size: var(--tone-label-size);
  }
  .archive-month time {
    font: 11px var(--mono); /* tone:fixed: 모노 마이크로 라벨(의장) */
    color: var(--fg-mute);
    flex: 0 0 42px;
  }
  .archive-month a > span {
    flex: 1;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .archive-month small {
    font: 10px var(--mono); /* tone:fixed: 모노 마이크로 라벨(의장) */
    color: var(--fg-mute);
  }
  .archive-month b {
    font-weight: 400;
  }
  .archive-empty {
    text-align: center;
    padding: var(--tone-section-gap) var(--tone-card-padding);
    background: var(--bg-elev);
    border-radius: var(--tone-radius-card);
  }
  .archive-empty p {
    margin: var(--tone-space-3) 0 var(--tone-space-4);
    font-size: var(--tone-label-size);
  }
  @media (max-width: 1000px) {
    .archive-intro {
      grid-template-columns: 1fr;
    }
    .archive-total {
      justify-self: start;
      padding: var(--tone-space-3) var(--tone-space-4);
    }
    .archive-total strong {
      font-size: 40px; /* tone:fixed: Georgia 합계 디스플레이 태블릿(의장) */
    }
    .story-grid {
      gap: var(--tone-space-3);
    }
    .story-card {
      padding: var(--tone-space-4);
    }
    .archive-month {
      grid-template-columns: 110px 1fr;
      gap: var(--tone-space-4);
    }
  }
  @media (max-width: 600px) {
    .archive-intro {
      padding-top: var(--tone-space-1);
      gap: var(--tone-space-4);
      margin-bottom: var(--tone-space-5);
      padding-bottom: var(--tone-space-5);
    }
    .archive-total {
      width: 100%;
      justify-content: space-between;
    }
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story-card {
      min-height: 220px; /* tone:fixed: 스토리 카드 모바일 고정 높이(의장) */
    }
    .latest-stories {
      margin-bottom: var(--tone-space-6);
    }
    .archive-search {
      width: 100%;
      justify-content: space-between;
    }
    .archive-search input {
      width: 100%;
    }
    .archive-browse > .section-head {
      align-items: start;
    }
    .archive-month {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: var(--tone-card-padding);
    }
    .archive-month h3 {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .archive-month h3 span {
      margin: 0;
    }
    .archive-month a {
      gap: var(--tone-space-2);
    }
    .archive-month small {
      display: none;
    }
  }
</style>

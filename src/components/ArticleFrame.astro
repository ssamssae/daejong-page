---
import "../styles/prose.css";
import { getCollection } from "astro:content";
const {
  title,
  summary,
  date,
  label,
  base,
  version,
  headings = [],
  sourceHref,
  searchable = false,
} = Astro.props;
const sections = headings.filter(
  (heading: { depth: number }) => heading.depth === 2,
);
const collection = ({ '/worklog/': 'worklog', '/newsletter/': 'newsletter', '/insights/': 'insights' } as const)[base];
let newer = Astro.props.newer;
let older = Astro.props.older;
if (collection) {
  const posts = (await getCollection(collection)).sort((a,b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id));
  const current = posts.findIndex(post => decodeURI(Astro.url.pathname).replace(/\/$/, '') === `${base}${post.id}`);
  const neighbor = (post) => post && ({ title: post.data.title, href: `${base}${post.id}/` });
  if (current >= 0) { newer = neighbor(posts[current - 1]); older = neighbor(posts[current + 1]); }
}
const context = label === '인사이트'
  ? '영상과 글을 보고 정리한 해석이에요. 원 출처의 주장과 직접 확인한 결과를 구분해 읽어요.'
  : label === '뉴스레터'
  ? '발행 당시의 생각과 작업을 담은 편지예요. 제품의 현재 기능과 설치 정보는 제품 목록에서 확인할 수 있어요.'
  : '작성 당시의 문제와 판단을 남긴 기록이에요. 도구와 운영 방식은 이후 달라질 수 있으며, 적용할 때는 현재 조건을 확인해요.';
---

<div class="article-frame">
  <a class="back" href={base}>← {label} 목록</a>
  <article>
    <header class="reading-header">
      <p class="eyebrow">작업장 / {label}</p><h1
        data-pagefind-body={searchable ? "" : undefined}
        data-pagefind-meta={searchable ? "title" : undefined}>{title}</h1>{
        summary && (
          <p class="reading-summary" data-pagefind-body={searchable ? "" : undefined}>{summary}</p>
        )
      }<div class="reading-meta">
        <time datetime={date}>{date}</time>{
          version && (
            <span>
              {/^ep/i.test(version) ? version.toUpperCase() : `v${version}`}
            </span>
          )
        }<span>강대종 · 마이너스베타스튜디오</span>
      </div>
    </header>
    <aside class="reading-context"><p>{context}</p>{sourceHref && <a href={sourceHref}>기록 원문 보기 ↗</a>}</aside>
    <div class="reading-layout">
      {
        sections.length > 0 && (
          <aside class="reading-toc" aria-label="목차">
            <>
              <p>이 글의 목차</p>
              <ol>
                {sections.map(
                  (heading: { slug: string; text: string }, index: number) => (
                    <li>
                      <a href={`#${heading.slug}`}>
                        <span>{String(index + 1).padStart(2, "0")}</span>
                        {heading.text}
                      </a>
                    </li>
                  ),
                )}
              </ol>
            </>
          </aside>
        )
      }<div class="prose" data-pagefind-body={searchable ? "" : undefined}><slot /></div>
    </div>
  </article>
  {(newer || older) && <nav class="reading-neighbors" aria-label="앞뒤 기록">
    {newer && <a href={newer.href}><small>← 더 최근 기록</small><strong>{newer.title}</strong></a>}
    {older && <a href={older.href}><small>이전 기록 →</small><strong>{older.title}</strong></a>}
  </nav>}
  <div class="reading-end">
    <span>기록은 다음 시작이 돼요.</span><a href={base}>{label} 더 읽기 ↗</a
    ><a href="/products/">이 작업장의 제품 ↗</a>
  </div>
</div>
<style>
  .reading-context { max-width:900px; /* tone:fixed: 글 머리열 편집 폭(본문보다 넓음) */ margin:0 0 var(--tone-space-5) auto; padding:var(--tone-space-3) var(--tone-space-4); background:var(--bg-elev); border-left:3px solid var(--accent); font-size:var(--tone-label-size); line-height:1.8; }
  .reading-context a { display:inline-block; margin-top:var(--tone-space-1); }
  .reading-neighbors { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:var(--tone-space-3); margin-top:var(--tone-space-6); }
  .reading-neighbors a { border:1px solid var(--border); border-radius:var(--tone-radius-card); padding:var(--tone-card-padding); text-decoration:none; overflow-wrap:anywhere; }
  .reading-neighbors small { display:block; color:var(--fg-mute); margin-bottom:var(--tone-space-2); }
  .reading-neighbors strong { font-size:var(--tone-label-size); line-height:1.7; }

  .article-frame {
    max-width: var(--tone-page-max);
    margin: auto;
  }
  .back {
    margin-bottom: var(--tone-space-5);
  }
  .reading-header {
    max-width: 900px; /* tone:fixed: 글 머리열 편집 폭(본문보다 넓음) */
    margin-left: auto;
    padding-bottom: var(--tone-space-5);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--tone-section-gap);
  }
  /* T-261024-060: h1 크기·자간은 공용 studio-page.css(id)가 이김 — 죽은 선언 삭제 */
  .reading-summary {
    font-size: var(--tone-body-size);
    line-height: 1.8;
    margin-top: var(--tone-space-4);
  }
  .reading-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tone-space-2) var(--tone-space-4);
    font-size: var(--tone-caption-size);
    color: var(--fg-mute);
    margin-top: var(--tone-space-5);
  }
  .reading-meta time {
    font-family: var(--mono);
  }
  .reading-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--tone-section-gap);
    align-items: start;
  }
  .reading-layout > .prose:only-child {
    grid-column: 2;
  }
  .reading-toc {
    position: sticky;
    top: 125px;
  }
  .reading-toc > p {
    font: 10px var(--mono); /* tone:fixed: 모노 마이크로 라벨(의장) */
    letter-spacing: 0.1em; /* tone:fixed: 모노 라벨 자간(의장) */
    color: var(--accent);
    margin-bottom: var(--tone-card-padding);
  }
  .reading-toc ol {
    list-style: none;
  }
  .reading-toc li + li {
    margin-top: var(--tone-space-3);
  }
  .reading-toc a {
    display: flex;
    gap: var(--tone-space-2);
    text-decoration: none;
    font-size: var(--tone-caption-size);
    line-height: 1.65;
    color: var(--fg-dim);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .reading-toc a:hover {
    color: var(--accent);
  }
  .reading-toc span {
    flex: 0 0 20px;
    font: 10px/2 var(--mono); /* tone:fixed: 모노 마이크로 번호(의장) */
    color: var(--fg-mute);
  }
  .reading-end {
    max-width: 900px; /* tone:fixed: 글 맺음열 편집 폭(본문보다 넓음) */
    margin: var(--tone-section-gap) 0 0 auto;
    padding: var(--tone-space-4) 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--tone-space-3) var(--tone-space-5);
    font-size: var(--tone-caption-size);
  }
  .reading-end > span {
    margin-right: auto;
    color: var(--fg-mute);
  }
  .reading-end a {
    text-decoration: none;
  }
  @media (max-width: 900px) {
    .reading-layout {
      grid-template-columns: 1fr;
      gap: var(--tone-space-5);
    }
    .reading-layout > .prose:only-child {
      grid-column: 1;
    }
    .reading-toc {
      position: static;
      background: var(--bg-elev);
      border-radius: var(--tone-radius-control);
      padding: var(--tone-space-4);
    }
    .reading-toc ol {
      columns: 2;
      column-gap: var(--tone-space-4);
    }
    .reading-toc li {
      break-inside: avoid;
    }
    .reading-header {
      margin-bottom: var(--tone-space-5);
    }
    .reading-end {
      margin-top: var(--tone-space-6);
    }
  }
  @media (max-width: 600px) {
    .reading-meta {
      gap: var(--tone-space-1) var(--tone-space-3);
    }
    .reading-toc {
      padding: var(--tone-card-padding);
    }
    .reading-toc ol {
      columns: 1;
    }
    .reading-end > span {
      width: 100%;
    }
  }
</style>

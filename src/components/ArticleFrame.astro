---
import "../styles/prose.css";
import { getCollection } from "astro:content";
const {
  title,
  summary,
  date,
  label,
  base,
  version,
  headings = [],
  sourceHref,
} = Astro.props;
const sections = headings.filter(
  (heading: { depth: number }) => heading.depth === 2,
);
const collection = ({ '/worklog/': 'worklog', '/newsletter/': 'newsletter', '/insights/': 'insights' } as const)[base];
let newer = Astro.props.newer;
let older = Astro.props.older;
if (collection) {
  const posts = (await getCollection(collection)).sort((a,b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id));
  const current = posts.findIndex(post => decodeURI(Astro.url.pathname).replace(/\/$/, '') === `${base}${post.id}`);
  const neighbor = (post) => post && ({ title: post.data.title, href: `${base}${post.id}/` });
  if (current >= 0) { newer = neighbor(posts[current - 1]); older = neighbor(posts[current + 1]); }
}
const context = label === '인사이트'
  ? '영상과 글을 보고 정리한 해석입니다. 원 출처의 주장과 직접 확인한 결과를 구분해 읽습니다.'
  : label === '뉴스레터'
  ? '발행 당시의 생각과 작업을 담은 편지입니다. 제품의 현재 기능과 설치 정보는 제품 목록에서 확인할 수 있습니다.'
  : '작성 당시의 문제와 판단을 남긴 기록입니다. 도구와 운영 방식은 이후 달라질 수 있으며, 적용할 때는 현재 조건을 확인합니다.';
---

<div class="article-frame">
  <a class="back" href={base}>← {label} 목록</a>
  <article>
    <header class="reading-header">
      <p class="eyebrow">FROM THE WORKSHOP / {label}</p><h1>{title}</h1>{
        summary && <p class="reading-summary">{summary}</p>
      }<div class="reading-meta">
        <time datetime={date}>{date}</time>{
          version && (
            <span>
              {/^ep/i.test(version) ? version.toUpperCase() : `v${version}`}
            </span>
          )
        }<span>강대종 · 마이너스베타스튜디오</span>
      </div>
    </header>
    <aside class="reading-context"><p>{context}</p>{sourceHref && <a href={sourceHref}>기록 원문 보기 ↗</a>}</aside>
    <div class="reading-layout">
      {
        sections.length > 0 && (
          <aside class="reading-toc" aria-label="목차">
            <>
              <p>이 글의 목차</p>
              <ol>
                {sections.map(
                  (heading: { slug: string; text: string }, index: number) => (
                    <li>
                      <a href={`#${heading.slug}`}>
                        <span>{String(index + 1).padStart(2, "0")}</span>
                        {heading.text}
                      </a>
                    </li>
                  ),
                )}
              </ol>
            </>
          </aside>
        )
      }<div class="prose"><slot /></div>
    </div>
  </article>
  {(newer || older) && <nav class="reading-neighbors" aria-label="앞뒤 기록">
    {newer && <a href={newer.href}><small>← 더 최근 기록</small><strong>{newer.title}</strong></a>}
    {older && <a href={older.href}><small>이전 기록 →</small><strong>{older.title}</strong></a>}
  </nav>}
  <div class="reading-end">
    <span>기록은 다음 시작이 됩니다.</span><a href={base}>{label} 더 읽기 ↗</a
    ><a href="/products/">이 작업장의 제품 ↗</a>
  </div>
</div>
<style>
  .reading-context { max-width:900px; margin:0 0 32px auto; padding:18px 22px; background:var(--bg-elev); border-left:3px solid var(--accent); font-size:14px; line-height:1.8; }
  .reading-context a { display:inline-block; margin-top:8px; }
  .reading-neighbors { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:16px; margin-top:40px; }
  .reading-neighbors a { border:1px solid var(--border); border-radius:12px; padding:20px; text-decoration:none; overflow-wrap:anywhere; }
  .reading-neighbors small { display:block; color:var(--fg-mute); margin-bottom:10px; }
  .reading-neighbors strong { font-size:15px; line-height:1.7; }

  .article-frame {
    max-width: 1180px;
    margin: auto;
  }
  .back {
    margin-bottom: 28px;
  }
  .reading-header {
    max-width: 900px;
    margin-left: auto;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 48px;
  }
  .reading-header h1 {
    font-size: clamp(32px, 4.4vw, 54px);
    line-height: 1.4;
    letter-spacing: -0.045em;
  }
  .reading-summary {
    font-size: 17px;
    line-height: 1.8;
    margin-top: 24px;
  }
  .reading-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-size: 11px;
    color: var(--fg-mute);
    margin-top: 28px;
  }
  .reading-meta time {
    font-family: var(--mono);
  }
  .reading-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 60px;
    align-items: start;
  }
  .reading-layout > .prose:only-child {
    grid-column: 2;
  }
  .reading-toc {
    position: sticky;
    top: 125px;
  }
  .reading-toc > p {
    font: 10px var(--mono);
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .reading-toc ol {
    list-style: none;
  }
  .reading-toc li + li {
    margin-top: 14px;
  }
  .reading-toc a {
    display: flex;
    gap: 12px;
    text-decoration: none;
    font-size: 12px;
    line-height: 1.65;
    color: var(--fg-dim);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .reading-toc a:hover {
    color: var(--accent);
  }
  .reading-toc span {
    flex: 0 0 20px;
    font: 10px/2 var(--mono);
    color: var(--fg-mute);
  }
  .reading-end {
    max-width: 900px;
    margin: 60px 0 0 auto;
    padding: 24px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    font-size: 12px;
  }
  .reading-end > span {
    margin-right: auto;
    color: var(--fg-mute);
  }
  .reading-end a {
    text-decoration: none;
  }
  @media (max-width: 900px) {
    .reading-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .reading-layout > .prose:only-child {
      grid-column: 1;
    }
    .reading-toc {
      position: static;
      background: var(--bg-elev);
      border-radius: 12px;
      padding: 24px;
    }
    .reading-toc ol {
      columns: 2;
      column-gap: 25px;
    }
    .reading-toc li {
      break-inside: avoid;
    }
    .reading-header {
      margin-bottom: 32px;
    }
    .reading-end {
      margin-top: 40px;
    }
  }
  @media (max-width: 600px) {
    .reading-header h1 {
      font-size: 30px;
    }
    .reading-summary {
      font-size: 15px;
    }
    .reading-meta {
      gap: 8px 16px;
    }
    .reading-toc {
      padding: 20px;
    }
    .reading-toc ol {
      columns: 1;
    }
    .reading-end > span {
      width: 100%;
    }
  }
</style>

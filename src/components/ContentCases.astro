---
interface Case { id: string; title: string; date: string; status: string; rows: { label: string; text: string }[]; href?: string; linkLabel?: string; }
interface Props { title: string; intro: string; cases: Case[]; }
const { title, intro, cases } = Astro.props;
---
<section class="content-cases"><header><h2>{title}</h2><p>{intro}</p></header><div class="case-list">{cases.map(item => <article id={item.id} class="content-case"><p class="case-meta"><time>{item.date}</time> · {item.status}</p><h3>{item.title}</h3><dl>{item.rows.map(row => <div><dt>{row.label}</dt><dd>{row.text}</dd></div>)}</dl>{item.href && <a href={item.href}>{item.linkLabel || '근거 기록 읽기'} ↗</a>}</article>)}</div></section>
<style>
.content-cases{margin-block:36px}.content-cases header{margin-bottom:24px}.content-cases h2{font-size:var(--text-h2);line-height:1.35}.content-cases header p,.case-meta{color:var(--fg-mute);line-height:1.7}.case-list{display:grid;gap:20px}.content-case{padding:24px;border:1px solid var(--border);border-radius:var(--radius-card);background:var(--bg-elev);scroll-margin-top:100px}.content-case h3{font-size:var(--text-h3);line-height:1.5;margin:8px 0 20px}.content-case dl{display:grid;gap:14px;margin:0 0 20px}.content-case dl>div{display:grid;grid-template-columns:110px minmax(0,1fr);gap:18px}.content-case dt{font-weight:700}.content-case dd{margin:0;color:var(--fg-dim);line-height:1.8;word-break:keep-all;overflow-wrap:anywhere}.content-case a{color:var(--accent);text-decoration:underline;text-underline-offset:4px}.case-meta{font-size:var(--text-meta)}@media(max-width:600px){.content-case{padding:18px}.content-case dl>div{grid-template-columns:1fr;gap:4px}}
</style>

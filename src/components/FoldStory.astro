---
// T-261015-016 — 강대종과 AI가 시도하고, 접고, 다시 연 결정을 한 흐름으로 보여준다.
// 데이터 = src/data/dead-ends-story.json. 인용은 원문 그대로이며, 재검토 조건은 재개 지시가 아니다.
import ListSearch from './ListSearch.astro';

type FlowEvent = { date: string; event: string; text: string; quote?: string | null };
type StoryEntry = {
  id: string;
  title: string;
  category: string;
  tried: string;
  flow: FlowEvent[];
  ai?: string | null;
  now: string;
  note?: string | null;
};
interface Props { entries: StoryEntry[]; edited: string }
const { entries, edited } = Astro.props;

const lastDate = (entry: StoryEntry) => entry.flow.map(f => f.date).sort().at(-1) ?? '';
const sorted = entries.slice().sort((a, b) => lastDate(b).localeCompare(lastDate(a)) || a.id.localeCompare(b.id));
const reopened = sorted.filter(entry => entry.flow.some(f => f.event === '다시 엶'));
const months = new Map<string, StoryEntry[]>();
for (const entry of sorted) {
  const key = lastDate(entry).slice(0, 7);
  if (!months.has(key)) months.set(key, []);
  months.get(key)?.push(entry);
}
const monthGroups = Array.from(months.entries()).map(([month, items]) => ({ month, items }));
const eventClass = (event: string) => ({ '시작': 'start', '접음': 'fold', '보류': 'hold', '방향 전환': 'turn', '다시 엶': 'reopen', '완료': 'done' }[event] ?? 'other');
const noteHrefFor = (slug: string) => `/notes/dead-ends/${encodeURIComponent(slug)}/`;
---
<section class="story-section" aria-labelledby="reopened-title">
  <div class="story-head">
    <p class="story-eyebrow">REOPENED</p>
    <h2 id="reopened-title">접었다가 다시 연 길</h2>
    <p>한 번 접은 일도 조건이 바뀌면 다시 열었습니다. 무엇이 바뀌었는지 강대종의 말과 함께 남깁니다.</p>
  </div>
  <div class="reopened-list">
    {reopened.map(entry => {
      const reopenQuote = entry.flow.filter(step => step.event === '다시 엶' && step.quote).at(-1)?.quote;
      return (
        <a class="reopen-card" href={`#story-${entry.id}`}>
          <span class="story-meta"><span>{entry.category}</span><span>{entry.flow.length}번의 결정</span></span>
          <strong>{entry.title}</strong>
          <ol class="reopen-path" aria-label="결정 흐름">
            {entry.flow.map(step => (
              <li class={`flow-${eventClass(step.event)}`}><time datetime={step.date}>{step.date.slice(5).replace('-', '.')}</time> {step.event}</li>
            ))}
          </ol>
          {reopenQuote && <span class="reopen-quote">「{reopenQuote}」</span>}
          <span class="reopen-more">연표에서 보기</span>
        </a>
      );
    })}
  </div>
</section>

<section class="story-section" aria-labelledby="timeline-title">
  <div class="story-head">
    <p class="story-eyebrow">STORY</p>
    <h2 id="timeline-title">강대종과 AI의 결정 연표</h2>
    <p>시도하고, 접고, 다시 연 결정 {sorted.length}건입니다. 최근 결정이 먼저 나옵니다. 편집 {edited}.</p>
  </div>
  <ListSearch target=".story-timeline > li > ol > li" label="결정 연표" placeholder="예: 앱, 자동화, 다시 엶" />
  <ol class="story-timeline">
    {monthGroups.map(group => (
      <li class="story-month">
        <h3>{group.month.replace('-', '.')}<span>{group.items.length}건</span></h3>
        <ol>
          {group.items.map(entry => (
            <li class="story-card" id={`story-${entry.id}`}>
              <p class="story-meta"><span>{entry.category}</span><span>{entry.flow.at(-1)?.event}</span></p>
              <h4>{entry.title}</h4>
              <p class="story-tried">{entry.tried}</p>
              <ol class="story-flow">
                {entry.flow.map(step => (
                  <li class={`flow-${eventClass(step.event)}`}>
                    <span class="flow-date">{step.date}</span>
                    <span class="flow-event">{step.event}</span>
                    <span class="flow-text">{step.text}</span>
                    {step.quote && <blockquote>「{step.quote}」<cite>강대종</cite></blockquote>}
                  </li>
                ))}
              </ol>
              {entry.ai && <p class="story-ai"><strong>AI가 한 일</strong>{entry.ai}</p>}
              <p class="story-now"><strong>지금</strong>{entry.now}</p>
              {entry.note && <a class="story-link" href={noteHrefFor(entry.note)}>자세한 기록 보기</a>}
            </li>
          ))}
        </ol>
      </li>
    ))}
  </ol>
</section>

<style>
  .story-section { display: flex; flex-direction: column; gap: 20px; }
  .story-head { display: grid; gap: 8px; max-width: 720px; }
  .story-eyebrow { color: var(--accent); font-size: var(--text-meta); font-weight: 700; letter-spacing: 0.08em; }
  .story-head h2 { color: var(--fg); font-size: var(--text-h2); line-height: var(--leading-h1); word-break: keep-all; }
  .story-head p:last-child { color: var(--fg-mute); font-size: var(--text-desc); line-height: var(--leading-desc); word-break: keep-all; }
  .reopened-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 14px; }
  .reopen-card { display: grid; align-content: start; gap: 10px; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--bg-elev); color: inherit; text-decoration: none; }
  .reopen-card:hover, .reopen-card:focus-visible { border-color: var(--accent); }
  .reopen-card > strong { color: var(--fg); font-size: var(--text-h3); line-height: 1.45; word-break: keep-all; }
  .reopen-path { display: flex; flex-wrap: wrap; gap: 4px 6px; margin: 0; padding: 0; list-style: none; color: var(--fg-mute); font-size: var(--text-meta); }
  .reopen-path li + li::before { content: '→'; margin-right: 6px; color: var(--fg-mute); }
  .reopen-path time { font-variant-numeric: tabular-nums; }
  .reopen-path .flow-reopen, .reopen-path .flow-turn { color: var(--accent); font-weight: 700; }
  .reopen-quote { color: var(--fg-dim); line-height: 1.7; word-break: keep-all; overflow-wrap: anywhere; }
  .reopen-more { color: var(--accent); font-size: var(--text-meta); }
  .story-card { display: grid; gap: 12px; padding: 22px; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--bg-elev); scroll-margin-top: 100px; }
  .story-card h3, .story-card h4 { color: var(--fg); font-size: var(--text-h3); line-height: 1.5; word-break: keep-all; }
  .story-meta { display: flex; flex-wrap: wrap; gap: 10px; color: var(--fg-mute); font-size: var(--text-meta); }
  .story-meta span + span::before { content: '·'; margin-right: 10px; }
  .story-tried, .story-ai, .story-now { color: var(--fg-dim); line-height: 1.8; word-break: keep-all; overflow-wrap: anywhere; }
  .story-ai strong, .story-now strong { color: var(--fg); margin-right: 10px; }
  .story-flow { display: grid; gap: 10px; margin: 0; padding: 0 0 0 14px; border-left: 2px solid var(--border); list-style: none; }
  .story-flow li { display: grid; grid-template-columns: auto auto minmax(0, 1fr); gap: 4px 10px; align-items: baseline; }
  .flow-date { color: var(--fg-mute); font-size: var(--text-meta); font-variant-numeric: tabular-nums; }
  .flow-event { color: var(--fg); font-size: var(--text-meta); font-weight: 700; }
  .flow-reopen .flow-event, .flow-turn .flow-event { color: var(--accent); }
  .flow-text { color: var(--fg-dim); line-height: 1.7; word-break: keep-all; overflow-wrap: anywhere; }
  .story-flow blockquote { grid-column: 1 / -1; margin: 2px 0 4px; padding: 10px 14px; border-radius: var(--radius-btn); background: var(--bg); color: var(--fg); line-height: 1.7; word-break: keep-all; overflow-wrap: anywhere; }
  .story-flow cite { display: block; margin-top: 4px; color: var(--fg-mute); font-size: var(--text-meta); font-style: normal; }
  .story-link { justify-self: start; color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .story-timeline { display: grid; gap: 28px; margin: 0; padding: 0; list-style: none; }
  .story-month > h3 { display: flex; gap: 10px; align-items: baseline; margin-bottom: 12px; color: var(--fg); font-size: var(--text-h3); }
  .story-month > h3 span { color: var(--fg-mute); font-size: var(--text-meta); font-weight: 400; }
  .story-month > ol { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  @media (max-width: 600px) {
    .story-card { padding: 16px; }
    .story-flow li { grid-template-columns: auto minmax(0, 1fr); }
    .flow-text { grid-column: 1 / -1; }
  }
</style>

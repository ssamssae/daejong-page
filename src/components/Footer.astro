---
import { company } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <p class="footer-kicker">STILL MAKING. ALWAYS LEARNING.</p><h2>
          다음 작은 시작도,<br />이곳에서.
        </h2>
      </div><div class="footer-links">
        <a href="/products/">제품 둘러보기 ↗</a><a href="/newsletter/"
          >만드는 이야기 ↗</a
        ><a href={`mailto:${company.email}`}>이야기 나누기 ↗</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-brand">
        <img src="https://kangdaejong.com/brand/current/logo.svg" alt="" width="42" height="42" /><strong>{company.name}</strong><a
          href={`mailto:${company.email}`}>{company.email}</a>
      </div><div class="biz">
        <span>{company.name} · 대표 {company.representative}</span><span
          >사업자등록번호 {company.bizNumber}</span
        ><span>통신판매업신고번호 {company.mailOrderNumber}</span><span
          >{company.address}</span
        ><span>{company.category}</span>
      </div>
    </div>
    <div class="footer-copy">
      <span>© {new Date().getFullYear()} MINUS BETA STUDIO</span><span
        class="footer-tagline">작게 만들고, 오래 다듬습니다.</span
      ><span class="visitors" data-visitors="daejong-page"
        >오늘 <b>-</b> · 누적 <b>-</b></span
      ><a href="#main-content">맨 위로 ↑</a>
    </div>
  </div>
</footer>
<script>
  import { loadVisitorCount } from "../lib/visitor-counter.mjs";
  const el = document.querySelector<HTMLElement>("[data-visitors]");
  if (el) {
    loadVisitorCount(el, {
      hostname: location.hostname,
      fetchImpl: fetch.bind(window),
    });
  }
</script>
<style>
  .site-footer {
    background: var(--bg);
    color: var(--fg);
    padding: 64px 0 24px;
  }
  .footer-inner {
    width: min(1000px, calc(100% - 48px));
    margin: auto;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 36px;
    padding-bottom: 50px;
    border-bottom: 1px solid var(--border);
  }
  .footer-kicker {
    font: 10px var(--mono);
    letter-spacing: 0.12em;
    margin-bottom: 20px;
    color: var(--fg-dim);
  }
  h2 {
    color: var(--fg);
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.35;
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: 14px;
    min-width: 180px;
    font-size: 14px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: #2458cc;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding: 34px 0;
  }
  .footer-brand {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 0 12px;
    align-content: start;
    font-size: 14px;
  }
  .footer-brand > img {
    grid-row: span 2;
    width: 42px;
    height: 42px;
  }

  .footer-brand a {
    color: var(--fg-dim);
    font-size: 12px;
    margin-top: 4px;
  }
  .biz {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    max-width: 560px;
    font-size: 11px;
    color: var(--fg-dim);
    line-height: 1.9;
  }
  .footer-copy {
    border-top: 1px solid var(--border);
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--fg-dim);
    font: 10px/1.6 var(--mono);
  }
  .visitors b {
    font-weight: 600;
    color: var(--fg);
  }
  @media (max-width: 900px) {
    .footer-inner {
      width: calc(100% - 48px);
    }
  }
  @media (max-width: 600px) {
    .site-footer {
      padding-top: 40px;
    }
    .footer-inner {
      width: calc(100% - 40px);
    }
    .footer-top,
    .footer-bottom {
      flex-direction: column;
      gap: 28px;
    }
    .footer-links {
      font-size: 13px;
    }
    .footer-copy {
      flex-wrap: wrap;
    }
    .footer-tagline {
      display: none;
    }
  }
</style>

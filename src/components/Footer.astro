---
import { company } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <p class="footer-kicker mb-eyebrow">계속 만들고, 계속 배워요.</p><h2>
          다음 작은 시작도,<br />이곳에서.
        </h2>
      </div><div class="footer-links">
        <a class="mb-link" href="/products/">제품 둘러보기 ↗</a><a class="mb-link" href="/newsletter/"
          >만드는 이야기 ↗</a
        ><a class="mb-link" href={`mailto:${company.email}`}>이야기 나누기 ↗</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-brand">
        <img src="https://kangdaejong.com/brand/current/logo.svg" alt="" width="42" height="42" /><strong>{company.name}</strong><a
          href={`mailto:${company.email}`}>{company.email}</a>
      </div><div class="biz">
        <span>{company.name} · 대표 {company.representative}</span><span
          >사업자등록번호 {company.bizNumber}</span
        ><span>통신판매업신고번호 {company.mailOrderNumber}</span><span
          >{company.address}</span
        ><span>{company.category}</span>
      </div>
    </div>
    <div class="footer-copy">
      <span>© {new Date().getFullYear()} 마이너스베타스튜디오</span><span
        class="footer-tagline">작게 만들고, 오래 다듬어요.</span
      ><span class="visitors" data-visitors="daejong-page"
        >오늘 <b>-</b> · 누적 <b>-</b></span
      ><a href="#main-content">맨 위로 ↑</a>
    </div>
  </div>
</footer>
<script>
  import { loadVisitorCount } from "../lib/visitor-counter.mjs";
  const el = document.querySelector<HTMLElement>("[data-visitors]");
  if (el) {
    loadVisitorCount(el, {
      hostname: location.hostname,
      fetchImpl: fetch.bind(window),
    });
  }
</script>
<style>
  /* T-261024-058: 눈썹 글(.mb-eyebrow)·글 링크(.mb-link)는 공용 부품, 제목(h2)은 공용 studio-page.css 의 톤 정의를 그대로 받는다.
     간격·글자 크기는 공용 톤 값(--tone-*)만 쓴다 — 직접 숫자 0. 폭 식은 본문 .site-main·공용 헤더와 같은 --tone-gutter 기준이다. */
  .site-footer {
    background: var(--bg);
    color: var(--fg);
    padding: var(--tone-section-gap) 0 var(--tone-space-4);
  }
  .footer-inner {
    width: min(var(--page-max, 1000px), calc(100% - var(--tone-gutter) * 2));
    margin: auto;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: var(--tone-space-5);
    padding-bottom: var(--tone-space-6);
    border-bottom: 1px solid var(--border);
  }
  h2 {
    color: var(--fg);
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: var(--tone-space-2);
    min-width: 180px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--tone-space-6);
    padding: var(--tone-space-5) 0;
  }
  .footer-brand {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 0 var(--tone-space-2);
    align-content: start;
    font-size: var(--tone-label-size);
  }
  .footer-brand > img {
    grid-row: span 2;
    width: 42px;
    height: 42px;
  }

  .footer-brand a {
    color: var(--fg-dim);
    font-size: var(--tone-caption-size);
  }
  .biz {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--tone-space-2);
    max-width: var(--tone-prose-max);
    font-size: var(--tone-caption-size);
    color: var(--fg-dim);
    line-height: 1.9;
  }
  .footer-copy {
    border-top: 1px solid var(--border);
    padding-top: var(--tone-space-3);
    display: flex;
    justify-content: space-between;
    gap: var(--tone-space-3);
    color: var(--fg-dim);
    font: var(--tone-caption-size) / var(--tone-caption-line) var(--tone-font);
  }
  .visitors b {
    font-weight: var(--tone-weight-bold);
    color: var(--fg);
  }
  @media (max-width: 600px) {
    .site-footer {
      padding-top: var(--tone-space-6);
    }
    .footer-top,
    .footer-bottom {
      flex-direction: column;
      gap: var(--tone-space-4);
    }
    .footer-copy {
      flex-wrap: wrap;
    }
    .footer-tagline {
      display: none;
    }
  }
</style>

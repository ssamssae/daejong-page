---
const path = Astro.url.pathname;
const active = path.startsWith('/worklog') ? 'worklog'
  : path.startsWith('/newsletter') ? 'newsletter'
  : ['/system', '/policy', '/automations.html', '/stack.html', '/skills.html', '/smart-home.html', '/knowhow.html'].some(p => path.startsWith(p)) ? 'system'
  : 'workshop';
---
<script is:inline src="https://kangdaejong.com/mb-components.js" defer></script>
<mb-header active={active} tone="studio"></mb-header>
<noscript><nav aria-label="기본 메뉴"><a href="https://kangdaejong.com/">마이너스베타스튜디오 홈</a> · <a href="https://kangdaejong.com/#products">제품</a> · <a href="https://kangdaejong.com/organization/">회사와 책임</a> · <a href="/system/">작업장 시스템</a></nav></noscript>

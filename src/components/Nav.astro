---
import { company, navPrimary, navMore } from "../data/site";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
const menu = [...navMore, { href: "/about/", label: "작업자 소개" }];
---

<header class="site-header">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label={`${company.name} 작업장 홈`}
      ><span class="brand-symbol" aria-hidden="true">mβ</span><span
        class="brand-word"
        >minus beta<span>독립적인 생각, 쓸모 있는 제품.</span></span
      ></a
    >
    <nav class="primary-nav" aria-label="주요 메뉴">
      {
        navPrimary.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <details class="site-menu">
        <summary aria-label="전체 메뉴"
          >더보기 <span aria-hidden="true">＋</span></summary
        ><nav aria-label="더보기 메뉴">
          {
            menu.map((link) => (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </nav>
      </details>
      <a class="contact-link" href={`mailto:${company.email}`}
        >이야기 나누기 <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #f7f6f2f5;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }
  .nav-inner {
    width: min(1280px, calc(100% - 96px));
    margin: auto;
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
  }
  .brand-symbol {
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    background: var(--accent-cta);
    color: #fffaf3;
    font:
      27px Georgia,
      serif;
    border-radius: 12px 12px 12px 3px;
    letter-spacing: -3px;
    padding-right: 3px;
  }
  .brand-word {
    font-size: 21px;
    line-height: 1.2;
    font-weight: 750;
    letter-spacing: -0.7px;
    white-space: nowrap;
  }
  .brand-word span {
    display: block;
    font-size: 10px;
    letter-spacing: 0.02em;
    font-weight: 450;
    color: var(--fg-mute);
    margin-top: 5px;
  }
  .primary-nav {
    display: flex;
    gap: 28px;
  }
  .primary-nav a {
    position: relative;
    padding: 10px 0;
    text-decoration: none;
    font-size: 14px;
    color: var(--fg-dim);
    white-space: nowrap;
  }
  .primary-nav a[aria-current] {
    color: var(--fg);
    font-weight: 700;
  }
  .primary-nav a[aria-current]::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }
  .nav-actions {
    display: flex;
    gap: 24px;
    align-items: center;
    font-size: 13px;
  }
  .contact-link {
    text-decoration: none;
    padding: 10px 15px;
    border: 1px solid var(--border);
    border-radius: 7px;
    white-space: nowrap;
  }
  .contact-link span {
    margin-left: 12px;
  }
  .site-menu {
    position: relative;
  }
  summary {
    list-style: none;
    display: flex;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    color: var(--fg-dim);
    white-space: nowrap;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    font-size: 20px;
    transition: transform 0.2s;
  }
  details[open] summary span {
    transform: rotate(45deg);
  }
  .site-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: 224px;
    padding: 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-pop);
  }
  .site-menu nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
  }
  .site-menu nav a:hover,
  .site-menu nav a[aria-current] {
    background: var(--bg-elev);
    color: var(--accent);
  }
  @media (max-width: 1100px) {
    .nav-inner {
      gap: 24px;
    }
    .primary-nav {
      gap: 20px;
    }
    .contact-link {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .nav-inner {
      width: calc(100% - 48px);
    }
  }
  @media (max-width: 640px) {
    .nav-inner {
      width: calc(100% - 36px);
      flex-wrap: wrap;
      gap: 0;
      padding-top: 14px;
    }
    .brand-word {
      font-size: 20px;
    }
    .brand-word span {
      display: none;
    }
    .brand-symbol {
      width: 36px;
      height: 36px;
      font-size: 24px;
    }
    .nav-actions {
      margin-left: auto;
    }
    .primary-nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 12px;
      margin-top: 8px;
    }
    .primary-nav a {
      padding: 10px 2px 13px;
      min-height: 44px;
      font-size: 13px;
    }
    .primary-nav a[aria-current]::after {
      bottom: 6px;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLDetailsElement>(".site-menu")
    .forEach((menu) => {
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !menu.contains(event.target))
          menu.open = false;
      });
      menu.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
    });
</script>

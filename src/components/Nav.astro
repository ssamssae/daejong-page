---
import { company, navPrimary, navMore } from "../data/site";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
const menu = [...navMore, { href: "/about/", label: "작업자 소개" }];
---

<header class="site-header">
  <div class="nav-inner">
    <a class="brand" href="https://kangdaejong.com/" aria-label={`${company.name} 홈`}
      ><img class="brand-symbol" src="/minusbeta-badge.svg?v=square" alt="" width="43" height="43" /><span
        class="brand-word"
        >minus beta<span>독립적인 생각, 쓸모 있는 제품.</span></span
      ></a
    >
    <nav class="primary-nav" aria-label="주요 메뉴">
      {
        navPrimary.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <div class="more">
        <button
          class="more-button"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="site-more-panel"
        >
          더보기 <span class="chevron" aria-hidden="true">▾</span>
        </button>
        <nav id="site-more-panel" class="more-panel" aria-label="더보기 메뉴">
          {
            menu.map((link) => (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </nav>
      </div>
      <a class="contact-link" href={`mailto:${company.email}`}
        >이야기 나누기 <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #f7f6f2f5;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }
  .nav-inner {
    width: min(1280px, calc(100% - 96px));
    margin: auto;
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
  }
  .brand-symbol {
    display: block;
    width: 43px;
    height: 43px;
    flex-shrink: 0;
  }

  .brand-word {
    font-size: 21px;
    line-height: 1.2;
    font-weight: 750;
    letter-spacing: -0.7px;
    white-space: nowrap;
  }
  .brand-word span {
    display: block;
    font-size: 10px;
    letter-spacing: 0.02em;
    font-weight: 450;
    color: var(--fg-mute);
    margin-top: 5px;
  }
  .primary-nav {
    display: flex;
    gap: 28px;
  }
  .primary-nav a {
    position: relative;
    padding: 10px 0;
    text-decoration: none;
    font-size: 14px;
    color: var(--fg-dim);
    white-space: nowrap;
  }
  .primary-nav a[aria-current] {
    color: var(--fg);
    font-weight: 700;
  }
  .primary-nav a[aria-current]::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }
  .nav-actions {
    display: flex;
    gap: 24px;
    align-items: center;
    font-size: 13px;
  }
  .contact-link {
    text-decoration: none;
    padding: 10px 15px;
    border: 1px solid var(--border);
    border-radius: 7px;
    white-space: nowrap;
  }
  .contact-link span {
    margin-left: 12px;
  }
  .more {
    position: relative;
  }
  .more-button {
    min-height: 44px;
    padding: 0 8px;
    border: 0;
    background: transparent;
    color: var(--fg-dim);
    cursor: pointer;
    font-family: inherit;
    font-size: 13px;
    white-space: nowrap;
  }
  .more-button:hover,
  .more.open .more-button {
    color: var(--accent);
  }
  .chevron {
    display: inline-block;
    margin-left: 5px;
    font-size: 9px;
    transition: transform 0.16s ease;
  }
  .more.open .chevron {
    transform: rotate(180deg);
  }
  .more-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 9px);
    display: none;
    width: 224px;
    padding: 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-pop);
  }
  .more.open .more-panel {
    display: grid;
  }
  .more-panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 13px;
  }
  .more-panel a:hover,
  .more-panel a[aria-current] {
    background: var(--bg-elev);
    color: var(--accent);
  }
  :where(a, button):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (max-width: 1100px) {
    .nav-inner {
      gap: 24px;
    }
    .primary-nav {
      gap: 20px;
    }
    .contact-link {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .nav-inner {
      width: calc(100% - 48px);
    }
  }
  @media (max-width: 640px) {
    .nav-inner {
      width: calc(100% - 36px);
      flex-wrap: wrap;
      gap: 0;
      padding-top: 14px;
    }
    .brand-word {
      font-size: 20px;
    }
    .brand-word span {
      display: none;
    }
    .brand-symbol {
      width: 36px;
      height: 36px;
      font-size: 24px;
    }
    .nav-actions {
      margin-left: auto;
    }
    .primary-nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 12px;
      margin-top: 8px;
    }
    .primary-nav a {
      padding: 10px 2px 13px;
      min-height: 44px;
      font-size: 13px;
    }
    .primary-nav a[aria-current]::after {
      bottom: 6px;
    }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>(".more").forEach((more) => {
    const button = more.querySelector<HTMLButtonElement>(".more-button");
    const panel = more.querySelector<HTMLElement>(".more-panel");
    if (!button || !panel) return;

    const closeMenu = (restoreFocus = false) => {
      more.classList.remove("open");
      button.setAttribute("aria-expanded", "false");
      if (restoreFocus) button.focus();
    };

    button.addEventListener("click", (event) => {
      event.stopPropagation();
      const open = more.classList.toggle("open");
      button.setAttribute("aria-expanded", String(open));
    });
    panel.addEventListener("click", (event) => event.stopPropagation());
    document.addEventListener("click", () => closeMenu(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && more.classList.contains("open")) {
        closeMenu(true);
      }
    });
  });
</script>

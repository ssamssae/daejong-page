---
import { nlAllowlist } from '../lib/nl-product-links';
import { SOURCES } from '../lib/nl-allowlist.mjs';

interface Props {
  campaign: string;
}
const { campaign } = Astro.props;
const hops = nlAllowlist.map((e) => ({ dest: e.dest, hop: e.hop }));
---
<script define:vars={{ campaign, source: SOURCES.web, hops }}>
  function norm(href) {
    try {
      const u = new URL(href, 'https://work.kangdaejong.com');
      u.hash = '';
      u.hostname = u.hostname.toLowerCase();
      if (u.pathname.length > 1) u.pathname = u.pathname.replace(/\/+$/, '');
      return u.toString();
    } catch {
      return '';
    }
  }
  const byDest = {};
  for (const item of hops) byDest[item.dest] = item.hop;
  const root = document.querySelector('article .prose');
  if (!root) {
    /* newsletter body missing */
  } else {
    for (const a of root.querySelectorAll('a[href]')) {
      const href = a.getAttribute('href');
      if (!href || href.startsWith('/nl-go/')) continue;
      const hop = byDest[norm(href)];
      if (!hop) continue;
      a.setAttribute('data-nl-original', href);
      a.setAttribute(
        'href',
        '/nl-go/' + encodeURIComponent(hop) + '/?c=' + encodeURIComponent(campaign) + '&s=' + encodeURIComponent(source),
      );
    }
  }
</script>

---
import { nlCollectorOrigin } from '../lib/nl-collector.mjs';
const collector = nlCollectorOrigin();
---
<span data-nl-visit-beacon data-collector={collector} hidden></span>
<script>
import { EVENTS, isBotUa } from '../lib/nl-events.mjs';
import { postConfirmedVisit, shouldMarkVisitSent, visitStorageKey } from '../lib/nl-client-send.mjs';
const collector = document.querySelector<HTMLElement>('[data-nl-visit-beacon]')?.dataset.collector;
const params = new URLSearchParams(location.search);
const clickId = params.get('nlc') || '';
const campaign = params.get('utm_campaign') || params.get('c') || '';
if (collector && params.get('from') === 'nl' && clickId && campaign && params.get('nl_test') !== '1' && !isBotUa(navigator.userAgent)) {
  const key = visitStorageKey(clickId);
  let alreadySent = false;
  try { alreadySent = sessionStorage.getItem(key) === 'ok'; } catch {}
  if (!alreadySent) {
    const result = await postConfirmedVisit(collector, {
      event: EVENTS.visit, source: 'web_newsletter', campaign,
      product: params.get('p') || 'products', click_id: clickId,
      occurred_at: new Date().toISOString(), dest_kind: 'first_party',
    });
    if (shouldMarkVisitSent(result)) {
      try { sessionStorage.setItem(key, 'ok'); } catch {}
    }
  }
}
</script>

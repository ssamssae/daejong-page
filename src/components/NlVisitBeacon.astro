---
import { EVENTS } from '../lib/nl-events.mjs';
import { nlCollectorOrigin } from '../lib/nl-collector.mjs';

const collector = nlCollectorOrigin();
const visitEvent = EVENTS.visit;
---
<script is:inline define:vars={{ collector, visitEvent }}>
  (function () {
    var params = new URLSearchParams(window.location.search);
    if (params.get('from') !== 'nl') return;
    var clickId = params.get('nlc') || '';
    var product = params.get('p') || 'products';
    var campaign = params.get('utm_campaign') || params.get('c') || '';
    var source = 'web_newsletter';
    if (!clickId || !campaign) return;
    if (params.get('nl_test') === '1') return;
    if (/googlebot|bingbot|applebot|crawler|spider|preview|nl-fixture|\bbot\b/i.test(navigator.userAgent || '')) return;
    var key = 'nl-visit:' + clickId;
    try {
      if (sessionStorage.getItem(key) === 'ok') return;
    } catch (e) {}
    if (!collector) return;
    var payload = {
      event: visitEvent,
      source: source,
      campaign: campaign,
      product: product,
      click_id: clickId,
      occurred_at: new Date().toISOString(),
      dest_kind: 'first_party',
    };
    var url = String(collector).replace(/\/$/, '') + '/v1/events';
    var body = JSON.stringify(payload);
    function mark(ok) {
      if (!ok) return;
      try { sessionStorage.setItem(key, 'ok'); } catch (e) {}
    }
    var sent = false;
    try {
      sent = navigator.sendBeacon(url, new Blob([body], { type: 'application/json' }));
    } catch (e) {}
    if (sent) {
      mark(true);
      return;
    }
    fetch(url, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: body,
      keepalive: true,
      mode: 'cors',
    }).then(function (r) { mark(!!r.ok); }).catch(function () { mark(false); });
  })();
</script>

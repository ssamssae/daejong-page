---
import { pageGroups } from '../data/page-directory';
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const current = normalize(Astro.url.pathname);
---
<details class="page-directory">
  <summary>작업장 전체 페이지 <span>목적에 맞는 페이지 찾기</span></summary>
  <nav aria-label="작업장 전체 페이지">
    {pageGroups.map(group => <section><h2>{group.title}</h2><ul>{group.pages.map(page => <li><a href={page.href} aria-current={normalize(page.href) === current ? 'page' : undefined}><strong>{page.label}</strong><span>{page.description}</span></a></li>)}</ul></section>)}
  </nav>
</details>
<style>
/* T-261024-058: 간격·글자 크기는 공용 톤 값(--tone-*)만 쓴다 — 직접 숫자 0. */
.page-directory { margin:var(--tone-section-gap) 0 0; border-block:1px solid var(--border); }
summary { cursor:pointer; padding:var(--tone-space-4) 0; font-weight:var(--tone-weight-bold); }
summary span { display:inline-block; margin-left:var(--tone-space-3); color:var(--fg-mute); font-size:var(--tone-caption-size); font-weight:var(--tone-weight); }
nav { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--tone-space-4); padding:var(--tone-space-2) 0 var(--tone-space-4); }
h2 { font-size:var(--tone-subtitle-size); margin-bottom:var(--tone-space-2); }
ul { list-style:none; padding:0; }
a { display:block; padding:var(--tone-space-2) 0; text-decoration:none; }
a strong { font-size:var(--tone-label-size); } a span { display:block; font-size:var(--tone-caption-size); color:var(--fg-mute); margin-top:var(--tone-space-1); overflow-wrap:anywhere; }
a[aria-current] strong { color:var(--accent); } a:hover strong { text-decoration:underline; }
@media(max-width:700px) { nav { grid-template-columns:1fr; gap:var(--tone-space-3); } summary span { display:block; margin:var(--tone-space-1) 0 0; } }
</style>

---
import { pageGroups } from '../data/page-directory';
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const current = normalize(Astro.url.pathname);
---
<details class="page-directory">
  <summary>작업장 전체 페이지 <span>목적에 맞는 페이지 찾기</span></summary>
  <nav aria-label="작업장 전체 페이지">
    {pageGroups.map(group => <section><h2>{group.title}</h2><ul>{group.pages.map(page => <li><a href={page.href} aria-current={normalize(page.href) === current ? 'page' : undefined}><strong>{page.label}</strong><span>{page.description}</span></a></li>)}</ul></section>)}
  </nav>
</details>
<style>
.page-directory { margin:56px 0 0; border-block:1px solid var(--border); }
summary { cursor:pointer; padding:22px 0; font-weight:600; }
summary span { display:inline-block; margin-left:16px; color:var(--fg-mute); font-size:13px; font-weight:400; }
nav { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; padding:12px 0 28px; }
h2 { font-size:16px; margin-bottom:12px; }
ul { list-style:none; padding:0; } li + li { margin-top:4px; }
a { display:block; padding:10px 0; text-decoration:none; }
a strong { font-size:14px; } a span { display:block; font-size:12px; color:var(--fg-mute); margin-top:4px; overflow-wrap:anywhere; }
a[aria-current] strong { color:var(--accent); } a:hover strong { text-decoration:underline; }
@media(max-width:700px) { nav { grid-template-columns:1fr; gap:20px; } summary span { display:block; margin:8px 0 0; } }
</style>

---
// 작업일지/뉴스레터/인사이트 공통 목록 렌더. base 는 컬렉션 라우트 prefix.
interface Post {
  id: string;
  data: { title: string; date: string; version?: string };
}
const { posts, base } = Astro.props as { posts: Post[]; base: string };
---

<ul class="post-list">
  {
    posts.map((p) => {
      // 뉴스레터는 version 이 "ep6" 형태 — "Ep.6" 배지로 노출. worklog(v1.0.1)·insights(없음)는 미표시.
      const epMatch = p.data.version?.match(/^ep(\d+)$/i);
      return (
        <li>
          <a href={`${base}/${p.id}/`}>
            <span class="date">{p.data.date}</span>
            <span class="ep" aria-hidden={epMatch ? undefined : "true"}>
              {epMatch ? `Ep.${epMatch[1]}` : ""}
            </span>
            <span class="title">{p.data.title}</span>
          </a>
        </li>
      );
    })
  }
</ul>
<style>
  .post-list {
    list-style: none;
  }
  .post-list li {
    border-bottom: 1px solid var(--border-soft);
  }
  .post-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 7px 14px;
    padding: 20px 0;
    text-decoration: none;
  }
  .post-list a:hover .title {
    color: var(--accent);
  }
  .date,
  .ep {
    font: 10px var(--mono);
    color: var(--fg-mute);
  }
  .title {
    grid-column: 1/-1;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 550;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .ep[aria-hidden="true"] {
    display: none;
  }
</style>

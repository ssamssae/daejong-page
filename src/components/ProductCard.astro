---
import ProductFacts from "./ProductFacts.astro";
import allFacts from "../data/product-facts.json";
interface Product {
  id: string;
  name: string;
  icon?: string;
  icon2x?: string;
  status: string;
  desc: string;
  links: { label: string; url: string; disabled?: boolean }[];
}
const { item, kind, label, index } = Astro.props as {
  item: Product;
  kind: string;
  label: string;
  index: number;
};
const icon = item.icon;
const facts = allFacts[item.name as keyof typeof allFacts];
const glyph =
  kind === "tool" ? ">_" : kind === "ebook" ? "Aa" : item.name.slice(0, 1);
---

<article
  class={`catalog-card mb-card kind-${kind}`}
  data-product-id={item.id}
  data-catalog-item
  data-kind={kind}
  data-search={`${item.name} ${item.desc} ${item.status} ${label} ${facts.price} ${facts.platform} ${facts.account}`}
>
  <div class="catalog-top">
    <span class="product-icon" aria-hidden="true"
      >{
        icon ? (
          <img src={icon} srcset={item.icon2x ? `${icon}, ${item.icon2x} 2x` : undefined} width="48" height="48" loading="lazy" alt="" />
        ) : (
          glyph
        )
      }</span
    ><span class="kind-label mb-chip">{label}</span>
  </div>
  <h3 class="mb-card-title">{item.name}</h3>
  <p class="description mb-card-text">{item.desc}</p>
  <div class="catalog-bottom">
    <ProductFacts name={item.name} /><div class="catalog-links">
      {
        item.links.map((link) =>
          link.disabled ? (
            <span class="disabled">{link.label}</span>
          ) : (
            <a
              class="mb-link"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${item.name} — ${link.label} (새 창)`}
            >
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ),
        )
      }
    </div>
  </div>
</article>
<style>
  /* T-261024-058: 카드 바탕·모서리·안쪽 여백·제목·설명(.mb-card)·종류 칩(.mb-chip)·링크(.mb-link)는 회사홈 공용 톤 파일의 부품이 정한다.
     여기에는 배치만 적고 직접 숫자를 두지 않는다 — verify-tone-copies 기준선 0. */
  .catalog-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .catalog-top {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: var(--tone-space-4);
  }
  .product-icon {
    display: grid;
    place-items: center;
    width: 48px; /* 그림 크기 = img width/height 속성(48)과 같은 값 */
    height: 48px;
    border-radius: var(--tone-radius-control);
    background: var(--accent-bg);
    color: var(--accent);
    font: var(--tone-weight-bold) var(--tone-title-size) / 1 var(--sans);
    overflow: hidden;
  }
  .product-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kind-tool .product-icon {
    font: var(--tone-weight-bold) var(--tone-subtitle-size) / 1 var(--mono);
  }
  .description {
    word-break: keep-all;
  }
  .catalog-bottom {
    margin-top: auto;
    padding-top: var(--tone-space-4);
  }
  .catalog-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tone-space-1) var(--tone-space-3);
    border-top: 1px solid var(--border-soft);
    padding-top: var(--tone-space-1);
  }
  .catalog-links a span {
    color: var(--fg-mute);
  }
  .disabled {
    display: inline-flex;
    align-items: center;
    min-height: var(--tone-tap-height);
    font-size: var(--tone-caption-size);
    color: var(--fg-mute);
  }
</style>

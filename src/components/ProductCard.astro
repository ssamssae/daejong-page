---
import ProductFacts from "./ProductFacts.astro";
import allFacts from "../data/product-facts.json";
interface Product {
  id: string;
  name: string;
  icon?: string;
  icon2x?: string;
  status: string;
  desc: string;
  links: { label: string; url: string; disabled?: boolean }[];
}
const { item, kind, label, index } = Astro.props as {
  item: Product;
  kind: string;
  label: string;
  index: number;
};
const icon = item.icon;
const facts = allFacts[item.name as keyof typeof allFacts];
const glyph =
  kind === "tool" ? ">_" : kind === "ebook" ? "Aa" : item.name.slice(0, 1);
---

<article
  class={`catalog-card kind-${kind}`}
  data-product-id={item.id}
  data-catalog-item
  data-kind={kind}
  data-search={`${item.name} ${item.desc} ${item.status} ${label} ${facts.price} ${facts.platform} ${facts.account}`}
>
  <div class="catalog-top">
    <span class="product-icon" aria-hidden="true"
      >{
        icon ? (
          <img src={icon} srcset={item.icon2x ? `${icon}, ${item.icon2x} 2x` : undefined} width="48" height="48" loading="lazy" alt="" />
        ) : (
          glyph
        )
      }</span
    ><span class="kind-label">{label}</span>
  </div>
  <h3>{item.name}</h3>
  <p class="description">{item.desc}</p>
  <div class="catalog-bottom">
    <ProductFacts name={item.name} /><div class="catalog-links">
      {
        item.links.map((link) =>
          link.disabled ? (
            <span class="disabled">{link.label}</span>
          ) : (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${item.name} — ${link.label} (새 창)`}
            >
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ),
        )
      }
    </div>
  </div>
</article>
<style>
  .catalog-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 23px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--tone-radius-card);
    transition:
      border-color 0.18s,
      transform 0.18s;
  }
  .catalog-card:hover {
    border-color: var(--accent-line-2);
    transform: none;
  }
  .catalog-top {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 23px;
  }
  .product-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--accent-bg);
    color: var(--accent);
    font: 23px var(--sans);
    overflow: hidden;
  }
  .product-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kind-tool .product-icon {
    background: var(--accent-bg);
    color: var(--accent);
    font: 20px var(--mono);
  }
  .kind-ebook .product-icon {
    background: var(--accent-bg);
    color: var(--accent);
  }
  .kind-label {
    font-size: 10px;
    color: var(--fg-mute);
    border: 1px solid var(--border-soft);
    border-radius: 4px;
    padding: 2px 7px;
  }
  h3 {
    font-size: 18px;
    line-height: 1.45;
    letter-spacing: -0.035em;
    margin-bottom: 10px;
  }
  .description {
    font-size: 13px;
    line-height: 1.75;
    word-break: keep-all;
  }
  .catalog-bottom {
    margin-top: auto;
    padding-top: 24px;
  }
  .status {
    font-size: 10px;
    color: var(--fg-mute);
    margin-bottom: 12px;
  }
  .catalog-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    border-top: 1px solid var(--border-soft);
    padding-top: 10px;
  }
  .catalog-links a {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }
  .catalog-links a span {
    color: var(--fg-mute);
  }
  .disabled {
    font-size: 12px;
    color: var(--fg-mute);
  }
</style>

---
// 허브 홈 섹션 카드.
const { href, title, desc, index, emoji } = Astro.props as {
  href: string; title: string; desc: string; index?: number; emoji?: string;
};
const label = typeof index === 'number' ? String(index).padStart(2, '0') : '→';
---
<a class="section-card" href={href}>
  <span class="sc-meta">
    <span>{label}</span>
    {emoji && <span aria-hidden="true">{emoji}</span>}
  </span>
  <span class="sc-title">{title}</span>
  <span class="sc-desc">{desc}</span>
  <span class="sc-arrow" aria-hidden="true">→</span>
</a>
<style>
  .section-card {
    display: flex;
    min-height: 188px;
    flex-direction: column;
    gap: 12px;
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-btn);
    padding: 22px;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    transition: border-color .15s, background-color .15s;
  }
  .section-card:hover {
    border-color: var(--fg);
    background: var(--bg-elev);
    color: var(--fg);
    text-decoration: none;
  }
  .sc-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--fg-mute);
    font-size: var(--text-meta);
    font-weight: 700;
  }
  .sc-title { font-weight: 700; font-size: var(--text-h2); line-height: var(--leading-h1); }
  .sc-desc { max-width: 28ch; font-size: var(--text-desc); color: var(--fg-dim); line-height: var(--leading-desc); }
  .sc-arrow { margin-top: auto; font-size: var(--text-lead); }
  @media (max-width: 640px) {
    .section-card { min-height: 156px; padding: 18px; }
  }
</style>

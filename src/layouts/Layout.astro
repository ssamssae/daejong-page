---
import "../styles/tokens.css";
import "../styles/workshop.css";
import "../styles/notebook.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
const { title, description } = Astro.props;
const notebook =
  /\.html\/?$/.test(Astro.url.pathname) ||
  ["/policy", "/sorry", "/_cost"].some((path) =>
    Astro.url.pathname.startsWith(path),
  );
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico?v=square" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/homepage_icon.svg?v=square" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=square" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Serif+KR:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <Nav />
    <main
      id="main-content"
      class:list={["site-main", notebook && "notebook"]}
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import "../styles/tokens.css";
import "../styles/workshop.css";
import "../styles/notebook.css";
import Nav from "../components/Nav.astro";
import PageDirectory from "../components/PageDirectory.astro";
import Footer from "../components/Footer.astro";
const { title, description, bodyClass = "", image } = Astro.props;
// T-261010-061: articles pass their own /og/... image; every other page keeps the shared one.
const shareImage = image
  ? new URL(image, "https://work.kangdaejong.com").href
  : "https://kangdaejong.com/brand/current/social.png?v=59a349c1f82627cd";
const notebook =
  /\.html\/?$/.test(Astro.url.pathname) ||
  ["/policy", "/sorry", "/_cost"].some((path) =>
    Astro.url.pathname.startsWith(path),
  );
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="https://kangdaejong.com/brand/current/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="https://kangdaejong.com/brand/current/logo.svg" />
    <link rel="apple-touch-icon" href="https://kangdaejong.com/brand/current/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, 'https://work.kangdaejong.com').href} />
    <meta property="og:site_name" content="마이너스베타스튜디오 작업장" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={shareImage} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:image" content={shareImage} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Serif+KR:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <link rel="stylesheet" href="https://kangdaejong.com/studio-page.css?v=20261003" />
    <slot name="head" />
  </head>
  <body class={`studio-page ${bodyClass}`}>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <Nav />
    <main
      id="main-content"
      class:list={["site-main", notebook && "notebook"]}
      tabindex="-1"
    >
      <slot />
      <PageDirectory />
    </main>
    <Footer />
  </body>
</html>

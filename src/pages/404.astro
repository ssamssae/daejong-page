---
import Layout from '../layouts/Layout.astro';
---
<Layout title="페이지를 찾을 수 없습니다 — 작업장" description="주소가 바뀌었거나 공개되지 않은 페이지입니다. 작업장 목록에서 다시 찾아보세요.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="not-found"><p>404</p><h1>이 주소의 페이지를 찾지 못했습니다.</h1><p>주소가 바뀌었거나 공개되지 않은 기록일 수 있습니다. 아래 전체 페이지 목록에서 주제를 찾거나 작업일지 검색을 이용해 주세요.</p><a href="/">작업장 홈으로</a><a href="/worklog/">작업일지에서 찾기</a></section>
</Layout>
<style>.not-found { max-width:720px; margin:60px auto; }.not-found h1 { font-size:clamp(28px,5vw,48px); line-height:1.4; }.not-found p { margin:20px 0; line-height:1.8; }.not-found a { display:inline-block; padding:12px 0; margin-right:24px; }</style>

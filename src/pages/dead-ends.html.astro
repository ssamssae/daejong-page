---
import ListSearch from '../components/ListSearch.astro';
import { noteHref } from '../lib/note-path.mjs';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import ContentCases from '../components/ContentCases.astro';
import FoldStory from '../components/FoldStory.astro';
import decisions from '../data/decision-lessons.json';
import story from '../data/dead-ends-story.json';

type DeadEndEntry = {
  file?: string;
  slug?: string;
  title: string;
  date: string;
  category?: string;
  tags?: string[];
  summary?: string;
};

const indexPath = join(process.cwd(), 'public/dead-ends/index.json');
const indexData = JSON.parse(readFileSync(indexPath, 'utf-8')) as { entries?: DeadEndEntry[] };

const entries = (indexData.entries ?? [])
  .slice()
  .sort((a, b) => {
    if (a.date !== b.date) return b.date.localeCompare(a.date);
    return (a.slug ?? '').localeCompare(b.slug ?? '');
  });

const featured = entries.slice(0, 3);
const latestDate = entries[0]?.date ?? '—';
const categories = new Map<string, number>();

for (const entry of entries) {
  if (!entry.category) continue;
  categories.set(entry.category, (categories.get(entry.category) ?? 0) + 1);
}

const categoryRows = Array.from(categories.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => {
    if (a.count !== b.count) return b.count - a.count;
    return a.name.localeCompare(b.name);
  });

const monthMap = new Map<string, DeadEndEntry[]>();
for (const entry of entries) {
  const key = entry.date.slice(0, 7);
  if (!monthMap.has(key)) monthMap.set(key, []);
  monthMap.get(key)?.push(entry);
}
const monthGroups = Array.from(monthMap.entries()).map(([month, items]) => ({ month, items }));

const storyDates = story.entries.flatMap((entry) => entry.flow.map((step) => step.date)).sort();
const reopenedCount = story.entries.filter((entry) => entry.flow.some((step) => step.event === '다시 엶')).length;
const newestDate = [latestDate, storyDates.at(-1) ?? ''].sort().at(-1) ?? latestDate;

const stats = [
  { label: '연표', value: `${story.entries.length}건` },
  { label: '다시 엶', value: `${reopenedCount}건` },
  { label: '기록', value: `${entries.length}건` },
  { label: '분류', value: `${categoryRows.length}개` },
  { label: '최신', value: newestDate },
];

const hrefFor = (entry: DeadEndEntry) => noteHref('dead-ends', entry);


const formatMonth = (month: string) => month.replace('-', '.');
---
<Layout title="막다른 길 — 마이너스베타스튜디오" description="강대종과 AI가 시도했다가 접은 일과 다시 연 일의 기록. 접은 이유와 강대종의 말, AI가 한 일, 다시 연 계기까지 남겨 다음 시도에서 같은 길을 피합니다.">
  <Fragment slot="head">
    <link rel="canonical" href="https://work.kangdaejong.com/dead-ends.html" />
    <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://work.kangdaejong.com/#person",
      "name": "강대종",
      "jobTitle": "Solo founder / Vibe coder",
      "url": "https://work.kangdaejong.com/",
      "sameAs": ["https://github.com/ssamssae"],
      "description": "1인 개발자 / Vibe coder / Solo founder"
    },
    {
      "@type": "WebSite",
      "@id": "https://work.kangdaejong.com/#website",
      "name": "강대종",
      "url": "https://work.kangdaejong.com/",
      "inLanguage": "ko",
      "author": {"@id": "https://work.kangdaejong.com/#person"}
    }
  ]
}
    </script>
  </Fragment>

  <div class="dead-page">
    <section class="dead-hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <p class="eyebrow">막다른 길</p>
        <h1 id="page-title">막다른 길</h1>
        <p class="lead">
          강대종과 AI가 시도했다가 접은 일, 접었다가 다시 연 일을 함께 남깁니다.
          안 되는 길을 지워두면 다음 작업은 더 빨리 좁혀집니다.
          결정 연표 편집은 {story.edited}, 판단 사례 편집은 2026-09-23, 원문 목록 정리는 2026-08-31입니다.
        </p>
      </div>
      <dl class="hero-stats" aria-label="막다른 길 요약">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <FoldStory entries={story.entries} edited={story.edited} />

    <ContentCases title="중단도 서로 다른 결정입니다" intro="2026-09-23 편집. 보류는 조건 대기, 중단은 해당 방식 종료, 방향 전환은 대안 선택입니다. 아래 재검토 조건은 편집 제안이며 작업 재개 지시가 아닙니다. 전체 22건의 원래 날짜와 기록은 아래에 보존합니다." cases={decisions}/>
    <section class="featured-section" aria-labelledby="featured-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">최근에 접은 일</p>
          <h2 id="featured-title">최근에 접은 길</h2>
        </div>
        <p>가장 최근 사례를 먼저 보여주고, 아래에는 월별 아카이브를 이어둡니다.</p>
      </div>

      <div class="featured-grid">
        {featured.map((entry, index) => (
          <a class={index === 0 ? 'dead-card primary' : 'dead-card'} href={hrefFor(entry)}>
            <span class="card-topline">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{entry.date}</span>
            </span>
            <strong>{entry.title}</strong>
            {entry.summary && <span class="summary">{entry.summary}</span>}
            <span class="read-more">보기</span>
          </a>
        ))}
      </div>
    </section>

    <section class="category-section" aria-labelledby="category-title">
      <div class="section-head compact">
        <div>
          <p class="eyebrow">반복된 패턴</p>
          <h2 id="category-title">막힌 유형</h2>
        </div>
      </div>

      <ol class="category-list">
        {categoryRows.map((category) => (
          <li>
            <span>{category.name}</span>
            <strong>{category.count}건</strong>
          </li>
        ))}
      </ol>
    </section>

    <section class="archive-section" aria-labelledby="archive-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">전체 기록</p>
          <h2 id="archive-title">전체 기록</h2>
        </div>
        <p>제목, 날짜, 분류, 태그를 한 줄 흐름으로 훑고 필요한 항목만 상세로 들어갑니다.</p>
      </div>

      <ListSearch target=".archive-list li" label="막다른 길" placeholder="예: 자동화, 로그인, 비용" />
      <div class="archive-list">
        {monthGroups.map((group) => (
          <section class="month-block" aria-labelledby={`month-${group.month}`}>
            <header>
              <h3 id={`month-${group.month}`}>{formatMonth(group.month)}</h3>
              <span>{group.items.length}건</span>
            </header>
            <ol>
              {group.items.map((entry) => (
                <li>
                  <a href={hrefFor(entry)}>
                    <span class="archive-date">{entry.date}</span>
                    <span class="archive-body">
                      <strong>{entry.title}</strong>
                      <span class="archive-meta">
                        {entry.category && <em>{entry.category}</em>}
                        {(entry.tags ?? []).slice(0, 3).map((tag) => <small>{tag}</small>)}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </section>

    <a class="back-link" href="/lab">← lab</a>
  </div>

  <style>
    .dead-page {
      --dead-accent: var(--accent);
      display: flex;
      flex-direction: column;
      gap: var(--tone-section-gap);
    }

    .dead-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
      gap: var(--tone-space-6);
      align-items: end;
      border-bottom: 1px solid var(--border);
      padding: var(--tone-space-3) 0 var(--tone-space-6);
    }

    .eyebrow {
      color: var(--fg-mute);
      font-family: var(--tone-font);
      font-size: var(--text-meta);
      font-weight: 600;
      letter-spacing: 0;
      margin-bottom: var(--tone-space-2);
    }

    h1 {
      color: var(--fg);
      font-size: var(--text-h1);
      line-height: 0.95;
      margin: 0 0 var(--tone-card-padding);
    }

    .lead {
      max-width: var(--tone-prose-max);
      color: var(--fg-dim);
      font-size: var(--text-lead);
      line-height: 1.75;
      word-break: keep-all;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: 1fr;
      border-top: 1px solid var(--fg);
    }

    .hero-stats div {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: var(--tone-space-3);
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      min-height: var(--tone-control-height);
      padding: var(--tone-space-3) 0;
    }

    .hero-stats dt {
      color: var(--fg-mute);
      font-size: var(--text-desc);
      font-weight: 600;
    }

    .hero-stats dd {
      min-width: 0;
      color: var(--fg);
      font-family: var(--tone-font);
      font-size: var(--text-lead);
      font-weight: 600;
      line-height: 1.45;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      gap: var(--tone-space-4);
      align-items: end;
      margin-bottom: var(--tone-card-padding);
    }

    .section-head.compact {
      display: block;
    }

    .section-head h2 {
      color: var(--fg);
      font-size: var(--text-h2);
      line-height: var(--leading-h1);
      word-break: keep-all;
    }

    .section-head > p {
      max-width: var(--tone-flow-max);
      color: var(--fg-mute);
      font-size: var(--text-desc);
      line-height: var(--leading-desc);
      text-align: right;
      word-break: keep-all;
    }

    .featured-grid {
      display: grid;
      grid-template-columns: 1.08fr 0.96fr 0.96fr;
      gap: var(--tone-space-3);
    }

    .dead-card {
      display: flex;
      min-height: 258px; /* tone:fixed: 카드 고정 높이(의장) */
      flex-direction: column;
      border: 1px solid var(--border);
      border-radius: var(--radius-btn);
      background: var(--bg);
      color: var(--fg);
      padding: var(--tone-space-4);
      text-decoration: none;
    }

    .dead-card:hover {
      background: var(--bg-elev);
      color: var(--fg);
      text-decoration: none;
    }

    .dead-card.primary {
      border-color: transparent;
      background: var(--fg);
      color: var(--bg);
    }

    .dead-card.primary .card-topline,
    .dead-card.primary .summary,
    .dead-card.primary .read-more {
      color: color-mix(in srgb, var(--bg) 72%, transparent);
    }

    .card-topline {
      display: flex;
      flex-direction: column;
      gap: 50px; /* tone:fixed: 카드 날짜-제목 큰 간격(의장) */
      margin-bottom: var(--tone-space-3);
      color: var(--fg-mute);
      font-family: var(--tone-font);
      font-size: var(--text-meta);
      font-weight: 600;
    }

    .dead-card strong {
      color: inherit;
      font-size: var(--text-h2);
      line-height: 1.32;
      margin-bottom: var(--tone-space-2);
      word-break: keep-all;
    }

    .summary {
      color: var(--fg-dim);
      font-size: var(--text-desc);
      line-height: var(--leading-body);
      word-break: keep-all;
    }

    .read-more {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 34px;
      margin-top: auto;
      border: 1px solid currentColor;
      border-radius: var(--tone-radius-pill);
      color: inherit;
      font-size: var(--text-desc);
      font-weight: 700;
    }

    .category-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 1px solid var(--border);
      border-left: 1px solid var(--border);
      list-style: none;
    }

    .category-list li {
      min-height: 96px; /* tone:fixed: 분류 셀 고정 높이(의장) */
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: var(--tone-space-3);
    }

    .category-list span {
      display: block;
      margin-bottom: var(--tone-space-3);
      color: var(--fg-mute);
      font-family: var(--tone-font);
      font-size: var(--text-meta);
      font-weight: 600;
    }

    .category-list strong {
      color: var(--fg);
      font-size: var(--text-h3);
      line-height: var(--leading-h1);
    }

    .archive-list {
      display: grid;
      gap: var(--tone-space-5);
    }

    .month-block {
      display: grid;
      grid-template-columns: 180px minmax(0, 1fr);
      gap: var(--tone-space-4);
      border-top: 1px solid var(--border);
      padding-top: var(--tone-space-4);
    }

    .month-block header {
      position: sticky;
      top: 96px;
      align-self: start;
    }

    .month-block h3 {
      color: var(--fg);
      font-family: var(--tone-font);
      font-size: var(--text-h3);
      line-height: var(--leading-h1);
      margin-bottom: var(--tone-space-1);
    }

    .month-block header span {
      color: var(--fg-mute);
      font-size: var(--text-desc);
    }

    .month-block ol {
      border-top: 1px solid var(--border-soft);
      list-style: none;
    }

    .month-block li {
      border-bottom: 1px solid var(--border-soft);
    }

    .month-block a {
      display: grid;
      grid-template-columns: 116px minmax(0, 1fr);
      gap: var(--tone-space-3);
      align-items: baseline;
      min-height: 68px; /* tone:fixed: 목록 행 고정 높이(의장) */
      padding: var(--tone-space-3) 0;
      color: var(--fg);
      text-decoration: none;
    }

    .month-block a:hover {
      background: var(--bg-elev);
      color: var(--fg);
      text-decoration: none;
    }

    .archive-date {
      color: var(--fg-mute);
      font-family: var(--tone-font);
      font-size: var(--text-meta);
    }

    .archive-body {
      display: grid;
      gap: var(--tone-space-1);
      min-width: 0;
    }

    .archive-body strong {
      color: var(--fg);
      font-size: var(--text-lead);
      line-height: 1.45;
      word-break: keep-all;
    }

    .archive-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--tone-space-1);
    }

    .archive-meta em,
    .archive-meta small {
      border: 1px solid var(--border);
      border-radius: var(--tone-radius-pill);
      color: var(--fg-mute);
      font-size: var(--text-badge);
      font-style: normal;
      line-height: 1.4;
      padding: 2px 8px; /* tone:fixed: 마이크로 칩(의장) */
    }

    .archive-meta em {
      border-color: color-mix(in srgb, var(--dead-accent) 36%, var(--border));
      color: var(--fg-dim);
    }

    .back-link {
      align-self: flex-start;
      color: var(--fg-mute);
      font-size: var(--text-desc);
      text-decoration: none;
    }

    .back-link:hover {
      color: var(--fg);
    }

    @media (max-width: 920px) {
      .dead-hero,
      .featured-grid,
      .month-block {
        grid-template-columns: 1fr;
      }

            .hero-stats {
        max-width: var(--tone-flow-max);
      }

      .category-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .month-block header {
        position: static;
      }
    }

    @media (max-width: 640px) {
      .dead-page {
        gap: var(--tone-space-6);
      }

      .dead-hero {
        gap: var(--tone-space-5);
        padding-top: var(--tone-space-1);
      }

      .hero-stats div,
      .month-block a {
        grid-template-columns: 1fr;
      }

      .section-head {
        display: block;
      }

      .section-head > p {
        margin-top: var(--tone-space-2);
        text-align: left;
      }

      .dead-card {
        min-height: 220px; /* tone:fixed: 카드 모바일 고정 높이(의장) */
        padding: var(--tone-card-padding);
      }

      .card-topline {
        gap: 36px; /* tone:fixed: 카드 날짜-제목 간격 모바일(의장) */
      }

      .category-list {
        grid-template-columns: 1fr;
      }

      .month-block {
        gap: var(--tone-space-3);
      }

      .month-block a {
        gap: var(--tone-space-1);
        min-height: auto;
        padding: var(--tone-space-3) 0;
      }
    }
  </style>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import ActivityCard from '../components/ActivityCard.astro';
import { getCollection } from 'astro:content';
import { apps, saas, tools, ebooks } from '../data/products';

const sortedWorklog = (await getCollection('worklog')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date) || (b.data.version ?? '').localeCompare(a.data.version ?? '')
);
const seenWorklogDates = new Set<string>();
const allWorklog = sortedWorklog.filter((post) => {
  if (seenWorklogDates.has(post.data.date)) return false;
  seenWorklogDates.add(post.data.date);
  return true;
});
const recentWorklog = allWorklog.slice(0, 5);

const epNum = (entry) => parseInt(String(entry.id).replace(/\D/g, ''), 10) || 0;
const allNewsletter = (await getCollection('newsletter')).sort((a, b) => epNum(b) - epNum(a));
const recentNewsletter = allNewsletter.slice(0, 4);

const allInsights = (await getCollection('insights')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const recentInsights = allInsights.slice(0, 4);

const featured = saas[0];

const stats = [
  { label: '제품', value: apps.length + tools.length + saas.length + ebooks.length, detail: `앱 ${apps.length} · 도구 ${tools.length} · SaaS ${saas.length} · 전자책 ${ebooks.length}` },
  { label: '작업일지', value: allWorklog.length, detail: '매일의 빌드 로그' },
  { label: '뉴스레터', value: `Ep.${epNum(allNewsletter[0])}`, detail: `총 ${allNewsletter.length}편` },
];

const routes = [
  { href: '/products/', label: '01', kicker: '제품', title: '제품', desc: '공개한 모바일 앱, 오픈소스 도구, 라이브 웹 서비스(첫이름)를 한 화면에서 봅니다.' },
  { href: '/worklog/', label: '02', kicker: '기록', title: '작업일지', desc: '하루 단위로 무엇을 만들고 고쳤는지 남긴 빌드 로그입니다.' },
  { href: '/timeline.html/', label: '03', kicker: '시간순', title: '개발 타임라인', desc: '첫 코드부터 지금까지의 출시, 인프라, 큰 결정을 시간순으로 훑습니다.' },
  { href: '/newsletter/', label: '04', kicker: '에피소드', title: '뉴스레터', desc: '바이브코딩과 1인 앱 제작 과정을 에피소드로 정리합니다.' },
  { href: '/insights/', label: '05', kicker: '학습', title: '인사이트', desc: '영상과 아티클에서 뽑은 학습 노트를 모아둡니다.' },
  { href: '/system/', label: '06', kicker: '구조', title: '시스템', desc: '물리 노드와 자동화 스택의 구조를 기록합니다.' },
  { href: '/lab/', label: '07', kicker: '실험', title: 'lab', desc: '실험, 잡학, 접은 시도까지 작업의 주변부를 보관합니다.' },
];

const surfaces = ['제품', '작업일지', '뉴스레터', '인사이트', '시스템', 'lab'];
---
<Layout title="강대종의 작업장 — work.kangdaejong.com" description="강대종의 작업장. 제품·오픈소스 도구·작업일지·뉴스레터·인사이트·자동화 스택을 한 곳에서 보는 허브.">
  <div class="home" data-tone="workshop-index">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">작업장 · 강대종</p>
        <h1 id="home-title">강대종의 작업장</h1>
        <p class="tagline">작게 만들고, 매일 남깁니다.</p>
        <p class="lead">
          강대종이 만든 앱, 오픈소스 도구, 자동화 시스템과 그 과정을 모은 공개 작업장입니다.
          제품은 작게 공개하고, 작업일지·뉴스레터·인사이트는 다음 빌드를 위해 남깁니다.
        </p>
        <p class="hero-products" aria-label="작업장 표면">{surfaces.join(' · ')}</p>
        <div class="hero-actions" aria-label="주요 이동">
          <a class="button primary" href="/products/">제품 보기</a>
          <a class="button secondary" href="/worklog/">작업일지 보기</a>
        </div>
      </div>
    </section>

    <section class="proof-strip" aria-label="작업장 요약">
      <dl class="hero-stats">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
            <span>{stat.detail}</span>
          </div>
        ))}
      </dl>
    </section>

    <section class="featured-section" aria-labelledby="featured-title">
      <article class="featured-card">
        <span>{featured.status}</span>
        <p class="featured-kicker">대표 웹 서비스</p>
        <h2 id="featured-title">{featured.name}</h2>
        <p>{featured.desc}</p>
        <div class="featured-links">
          {featured.links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener">{link.label} →</a>
          ))}
        </div>
      </article>
    </section>

    <section class="route-section" aria-labelledby="routes-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">색인</p>
          <h2 id="routes-title">들어갈 곳을 고릅니다.</h2>
        </div>
        <p>제품, 기록, 시스템을 같은 작업장 안에서 엽니다.</p>
      </div>

      <div class="route-grid">
        {routes.map((route) => (
          <a class="route-card" href={route.href}>
            <span class="route-top">
              <span>{route.label}</span>
              <span>{route.kicker}</span>
            </span>
            <strong>{route.title}</strong>
            <span>{route.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="bridge-section" aria-labelledby="bridge-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">공개 도구</p>
          <h2 id="bridge-title">폰에서 작업장을 다루려고 만든 브릿지</h2>
        </div>
        <p>개인 운영에서 출발했지만 공개 저장소와 릴리스로 관리합니다.</p>
      </div>

      <div class="bridge-grid">
        {tools.map((project) => (
          <article class="bridge-card">
            <div class="bridge-card-top">
              <h3>{project.name}</h3>
              <span>{project.status}</span>
            </div>
            <p>{project.desc}</p>
            <div class="bridge-links">
              {project.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <ActivityCard />

    <section class="recent-grid" aria-label="최근 기록">
      <article class="recent-panel">
        <div class="recent-head">
          <div>
            <p class="eyebrow">작업일지</p>
            <h2>최근 작업일지</h2>
          </div>
          <a href="/worklog/">전체 보기</a>
        </div>
        <PostList posts={recentWorklog} base="/worklog" />
      </article>

      <article class="recent-panel">
        <div class="recent-head">
          <div>
            <p class="eyebrow">뉴스레터</p>
            <h2>최근 뉴스레터</h2>
          </div>
          <a href="/newsletter/">전체 보기</a>
        </div>
        <PostList posts={recentNewsletter} base="/newsletter" />
      </article>

      <article class="recent-panel">
        <div class="recent-head">
          <div>
            <p class="eyebrow">인사이트</p>
            <h2>최근 인사이트</h2>
          </div>
          <a href="/insights/">전체 보기</a>
        </div>
        <PostList posts={recentInsights} base="/insights" />
      </article>
    </section>
  </div>

  <style>
    .home {
      display: flex;
      flex-direction: column;
      gap: 96px;
    }

    .home-hero {
      position: relative;
      padding: 40px 0 16px;
    }

    .eyebrow {
      color: var(--fg-mute);
      font-family: var(--mono);
      font-size: var(--text-meta);
      font-weight: 600;
      letter-spacing: 0.06em;
      margin-bottom: 12px;
    }

    .hero-copy h1 {
      max-width: 18ch;
      font-size: var(--text-h1);
      line-height: var(--leading-h1);
      font-weight: 600;
      letter-spacing: -0.05em;
      word-break: keep-all;
    }

    .tagline {
      margin-top: 16px;
      color: var(--fg-dim);
      font-family: var(--mono);
      font-size: var(--text-meta);
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .lead {
      max-width: var(--measure);
      margin-top: 18px;
      color: var(--fg-dim);
      font-size: var(--text-lead);
      line-height: var(--leading-body);
      word-break: keep-all;
    }

    .hero-products {
      margin-top: 22px;
      max-width: 46rem;
      color: var(--fg-mute);
      font-family: var(--mono);
      font-size: var(--text-meta);
      line-height: 1.7;
      word-break: keep-all;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 18px;
      border: 1px solid var(--border);
      border-radius: var(--radius-btn);
      font-size: var(--text-desc);
      font-weight: 600;
      text-decoration: none;
    }

    .button:hover { text-decoration: none; }

    .button.primary {
      border-color: var(--accent-cta);
      background: var(--accent-cta);
      color: var(--cta-fg);
    }

    .button.primary:hover {
      border-color: var(--accent-dim);
      background: var(--accent-dim);
      color: var(--cta-fg);
    }

    .button.secondary {
      background: var(--bg);
      color: var(--fg);
    }

    .button.secondary:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .proof-strip { padding: 0; }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .hero-stats div {
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
      padding: 28px 20px 28px 0;
    }

    .hero-stats div + div {
      padding-left: 20px;
      border-left: 1px solid var(--border-soft);
    }

    .hero-stats dt {
      color: var(--fg-mute);
      font-family: var(--mono);
      font-size: var(--text-badge);
      font-weight: 600;
      letter-spacing: 0.06em;
    }

    .hero-stats dd {
      color: var(--fg);
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.15;
    }

    .hero-stats span {
      color: var(--fg-dim);
      font-size: var(--text-desc);
      line-height: 1.45;
    }

    .featured-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-width: 40rem;
      padding: 32px;
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      background: var(--bg-elev);
    }

    .featured-card > span,
    .bridge-card-top span {
      color: var(--fg-mute);
      font-family: var(--mono);
      font-size: var(--text-badge);
      font-weight: 600;
      letter-spacing: 0.06em;
    }

    .featured-kicker {
      color: var(--fg);
      font-size: var(--text-body);
      font-weight: 600;
    }

    .featured-card h2 {
      font-size: clamp(28px, 4vw, 40px);
      letter-spacing: -0.04em;
      word-break: keep-all;
    }

    .featured-card p,
    .bridge-card p {
      color: var(--fg-dim);
      font-size: var(--text-body);
      line-height: var(--leading-body);
      word-break: keep-all;
    }

    .featured-links,
    .bridge-links {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 8px;
      font-family: var(--mono);
      font-size: var(--text-meta);
      font-weight: 600;
    }

    .section-head {
      display: grid;
      gap: 12px;
      margin-bottom: 40px;
    }

    .section-head h2 {
      max-width: 720px;
      font-size: var(--text-h2);
      line-height: 1.18;
      letter-spacing: -0.045em;
      word-break: keep-all;
    }

    .section-head > p {
      max-width: var(--measure);
      color: var(--fg-mute);
      font-size: var(--text-body);
      line-height: var(--leading-desc);
    }

    @media (min-width: 860px) {
      .section-head {
        grid-template-columns: minmax(0, 1.15fr) minmax(220px, 0.85fr);
        gap: 48px;
        align-items: end;
      }
    }

    .route-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap-card);
    }

    .route-card {
      display: grid;
      gap: 10px;
      min-height: 200px;
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      color: var(--fg);
      text-decoration: none;
    }

    .route-card:hover {
      border-color: var(--accent);
      background: var(--bg-elev);
      color: var(--fg);
      text-decoration: none;
    }

    .route-top {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      color: var(--fg-mute);
      font-family: var(--mono);
      font-size: var(--text-meta);
      font-weight: 600;
    }

    .route-card strong {
      font-size: var(--text-h3);
      line-height: 1.3;
    }

    .route-card > span:last-child {
      align-self: end;
      color: var(--fg-dim);
      font-size: var(--text-desc);
      line-height: var(--leading-desc);
    }

    .bridge-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap-card);
    }

    .bridge-card {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      padding: 22px;
      background: var(--bg);
    }

    .bridge-card:hover { border-color: var(--accent); }

    .bridge-card-top {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
    }

    .bridge-card h3 {
      font-size: var(--text-h3);
      line-height: 1.3;
      word-break: keep-all;
    }

    .bridge-links { margin-top: auto; padding-top: 8px; }

    .recent-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
      padding-top: 8px;
    }

    .recent-panel { min-width: 0; }

    .recent-head {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 14px;
    }

    .recent-head h2 {
      font-size: var(--text-h2);
      line-height: 1.25;
    }

    .recent-head a {
      flex: 0 0 auto;
      margin-top: 4px;
      font-size: var(--text-desc);
      font-weight: 700;
      text-decoration: none;
    }

    .recent-head a:hover { text-decoration: underline; }

    @media (max-width: 1180px) {
      .recent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 920px) {
      .home { gap: 72px; }

      .hero-stats,
      .bridge-grid,
      .recent-grid,
      .route-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

      .hero-stats div + div { padding-left: 16px; }
    }

    @media (max-width: 640px) {
      .home { gap: 56px; }

      .home-hero { padding-top: 8px; }

      .hero-actions { flex-direction: column; }

      .button { width: 100%; }

      .hero-stats,
      .route-grid,
      .bridge-grid,
      .recent-grid { grid-template-columns: 1fr; }

      .hero-stats { border-bottom: 0; }

      .hero-stats div {
        padding: 18px 0;
        border-left: 0;
        border-bottom: 1px solid var(--border-soft);
      }

      .hero-stats div + div { padding-left: 0; }

      .featured-card { padding: 22px; }

      .route-card { min-height: 0; }

      .bridge-card-top,
      .recent-head { display: block; }

      .bridge-card-top span,
      .recent-head a {
        display: inline-flex;
        margin-top: 8px;
      }
    }
  </style>
</Layout>

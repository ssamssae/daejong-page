---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import ActivityCard from "../components/ActivityCard.astro";
import { getCollection } from "astro:content";
import { apps, saas, tools, ebooks } from "../data/products";

const sortedWorklog = (await getCollection("worklog")).sort(
  (a, b) =>
    b.data.date.localeCompare(a.data.date) ||
    (b.data.version ?? "").localeCompare(a.data.version ?? ""),
);
const seenWorklogDates = new Set<string>();
const allWorklog = sortedWorklog.filter((post) => {
  if (seenWorklogDates.has(post.data.date)) return false;
  seenWorklogDates.add(post.data.date);
  return true;
});
const recentWorklog = allWorklog.slice(0, 5);

const epNum = (entry) => parseInt(String(entry.id).replace(/\D/g, ""), 10) || 0;
const allNewsletter = (await getCollection("newsletter")).sort(
  (a, b) => epNum(b) - epNum(a),
);
const recentNewsletter = allNewsletter.slice(0, 4);

const allInsights = (await getCollection("insights")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const recentInsights = allInsights.slice(0, 4);

const total = apps.length + tools.length + saas.length + ebooks.length;
const spaces = [
  {
    href: "/worklog/",
    label: "01 / 작업일지",
    title: "만드는 날들",
    desc: "오늘 만든 것과 고친 것. 작은 진전이 쌓이는 기록.",
    count: allWorklog.length + "일의 기록",
  },
  {
    href: "/newsletter/",
    label: "02 / 뉴스레터",
    title: "과정에서 건진 이야기",
    desc: "혼자 일하며 배우는 출시, 자동화, 그리고 시행착오.",
    count: allNewsletter.length + "통의 편지",
  },
  {
    href: "/insights/",
    label: "03 / 인사이트",
    title: "다음 생각의 재료",
    desc: "영상과 글에서 얻은 배움을 다음 작업으로 연결해요.",
    count: allInsights.length + "개의 노트",
  },
];
---

<Layout
  title="강대종의 작업장 — 마이너스베타스튜디오"
  description="작은 아이디어를 쓸모 있는 제품으로. 강대종이 만드는 앱, 도구, 웹 서비스와 매일의 작업 기록을 만나보세요."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-copy">
      <p class="eyebrow mb-eyebrow">1인 디지털 작업장</p><h1 id="home-title">
        만들고, 고치고,<br />기록해요<span>.</span>
      </h1><p class="lead">
        강대종이 제품을 만들며 남긴 작업 기록이에요.<br />무엇을 고쳤고, 어디서 막혔고,<br class="desktop-break" /> 무엇을 배웠는지 공개된 글로 읽어보세요.
      </p><div class="hero-actions">
        <a class="mb-btn mb-btn--primary" href="/worklog/"
          >최근 작업 읽기 <span aria-hidden="true">↗</span></a
        ><a class="mb-btn mb-btn--secondary" href="/newsletter/"
          >뉴스레터 읽기 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="home-art">
      <a class="workbench-note mb-card" href={`/newsletter/${recentNewsletter[0].id}/`}><span>가장 최근의 이야기 · {recentNewsletter[0].data.date}</span><strong>{recentNewsletter[0].data.title}</strong><p>{recentNewsletter[0].data.summary}</p><b class="mb-link">과정 읽기 ↗</b></a>
    </div>
  </section>
  <div class="studio-strip">
    <span>마이너스베타스튜디오</span><span>모바일 앱 <b>{apps.length}</b></span
    ><span>웹 서비스 <b>{saas.length}</b></span><span
      >오픈소스 <b>{tools.length}</b></span
    ><span>전자책 <b>{ebooks.length}</b></span>
  </div>
  <aside class="workshop-purpose"><p>쓸 제품을 찾고 계신가요? 제품 목록에서 기능과 실제 화면을 살펴보세요.</p><a class="mb-link" href="/products/">모든 제품 보기 ↗</a><a class="mb-link" href="https://founder.kangdaejong.com/">만드는 사람 소개 ↗</a></aside>
  <a class="jarvis-highlight mb-card" href="/jarvis/">
    <div><span class="mb-eyebrow">새로 공개 · 자비스</span><h2>자비스를 불렀더니, 네스트가 답했다.</h2><p>Mac 마이크와 Cursor, 집에 있던 스피커를 연결했다. 실제 호출·청취까지 확인한 오픈소스 실험.</p></div>
    <strong class="mb-link">제작기와 실측 보기 ↗</strong>
  </a>
  <section class="writing-section" aria-labelledby="writing-title">
    <div class="section-head">
      <div>
        <p class="eyebrow mb-eyebrow">과정의 기록</p><h2 id="writing-title">
          결과만큼, 과정도 남겨요.
        </h2>
      </div><p>잘된 일도, 막다른 길도.<br />다음 시작을 위한 기록들이에요.</p>
    </div><div class="spaces">
      {
        spaces.map((space) => (
          <a class="space mb-card" href={space.href}>
            <>
              <span class="space-label mb-eyebrow">{space.label}</span>
              <h3>{space.title}</h3>
              <p>{space.desc}</p>
              <span class="space-bottom">
                {space.count}
                <b aria-hidden="true">↗</b>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="recent-writing" aria-label="최근 기록">
    <div>
      <div class="recent-head">
        <p class="eyebrow mb-eyebrow">작업일지</p><a class="mb-link" href="/worklog/"
          >작업일지 전체 ↗</a>
      </div><PostList posts={recentWorklog} base="/worklog" />
    </div><div>
      <div class="recent-head">
        <p class="eyebrow mb-eyebrow">뉴스레터</p><a class="mb-link" href="/newsletter/"
          >뉴스레터 전체 ↗</a>
      </div><PostList posts={recentNewsletter} base="/newsletter" />
    </div>
  </section>
  <ActivityCard />
  <section class="explore-more" aria-labelledby="explore-title">
    <div>
      <p class="eyebrow mb-eyebrow">더 둘러보기</p><h2 id="explore-title">
        작업장의 다른 서랍들.
      </h2>
    </div><div class="drawer-links">
      <a href="/system/">시스템 <span>작업을 지탱하는 구조 ↗</span></a><a
        href="/lab/">실험실 <span>궁금해서 해본 것들 ↗</span></a
      ><a href="/timeline.html/">타임라인 <span>처음부터 지금까지 ↗</span></a>
    </div>
  </section>
  <style>
    /* T-261024-058: 카드(.mb-card)·버튼(.mb-btn)·눈썹 글(.mb-eyebrow)·글 링크(.mb-link)는 회사홈 공용 톤 파일의 부품이 정하고,
       남는 배치 간격·글자 크기는 공용 톤 값(--tone-*)만 쓴다 — 직접 숫자 0(verify-tone-copies).
       마크업에 없던 옛 규칙(.home-art-note·.hand-note·.note-dot·.home-selected·.home-products·.home-product)은 지웠다. */
    .home-hero {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
      gap: var(--tone-section-gap);
      padding: 0 0 var(--tone-section-gap);
    }
    .home-copy h1 {
      font-size: var(--tone-display-size);
      line-height: var(--tone-display-line);
      letter-spacing: var(--tone-tracking-title);
    }
    .home-copy h1 > span {
      color: var(--accent);
    }
    .home-copy .lead {
      font-size: var(--text-lead);
      margin-top: var(--tone-space-4);
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--tone-space-2);
      margin-top: var(--tone-space-5);
    }
    .home-art {
      position: relative;
    }
    .workbench-note {
      display: flex;
      flex-direction: column;
      gap: var(--tone-space-3);
      color: inherit;
      text-decoration: none;
    }
    .workbench-note > span {
      font-size: var(--tone-caption-size);
      color: var(--fg-dim);
    }
    .workbench-note > strong {
      font-size: var(--tone-title-size);
      line-height: var(--tone-title-line);
      letter-spacing: var(--tone-tracking-title);
      word-break: keep-all;
    }
    .workbench-note > p {
      word-break: keep-all;
    }
    .workshop-purpose {
      display: flex;
      flex-wrap: wrap;
      gap: var(--tone-space-2) var(--tone-space-4);
      padding: var(--tone-space-4) 0 var(--tone-space-6);
      font-size: var(--tone-label-size);
      line-height: var(--tone-label-line);
    }
    .workshop-purpose p {
      flex: 1 1 100%;
    }
    .jarvis-highlight {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--tone-space-4);
      margin: 0 0 var(--tone-section-gap);
      border-left: 4px solid var(--accent-2);
      text-decoration: none;
    }
    .jarvis-highlight span {
      display: block;
      color: var(--accent-2);
    }
    .jarvis-highlight h2 {
      margin: var(--tone-space-1) 0;
    }
    .jarvis-highlight p {
      font-size: var(--tone-label-size);
      line-height: var(--tone-label-line);
      max-width: 64ch;
    }
    .jarvis-highlight > strong {
      white-space: nowrap;
    }
    .studio-strip {
      display: flex;
      gap: var(--tone-space-4);
      justify-content: space-between;
      align-items: center;
      border-block: 1px solid var(--border);
      padding: var(--tone-space-4) 0;
      margin-bottom: var(--tone-section-gap);
      font-size: var(--tone-caption-size);
      color: var(--fg-dim);
    }
    .studio-strip > span:first-child {
      font: var(--tone-weight-bold) var(--tone-caption-size) / var(--tone-caption-line) var(--tone-font);
    }
    .studio-strip b {
      font-weight: var(--tone-weight-bold);
      color: var(--fg);
      margin-left: var(--tone-space-1);
    }
    .writing-section {
      margin-bottom: var(--tone-section-gap);
    }
    .spaces {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--tone-space-2);
    }
    .space {
      display: flex;
      flex-direction: column;
      text-decoration: none;
    }
    .space .space-label {
      display: block;
      color: var(--accent);
    }
    .space h3 {
      margin: var(--tone-space-4) 0 var(--tone-space-2);
    }
    .space-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      padding-top: var(--tone-space-5);
      font-size: var(--tone-caption-size);
      color: var(--fg-mute);
    }
    .space-bottom b {
      font-size: var(--tone-title-size);
      font-weight: var(--tone-weight);
      color: var(--fg);
    }
    .recent-writing {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--tone-space-6);
      margin-bottom: var(--tone-section-gap);
    }
    .recent-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--border);
    }
    .explore-more {
      margin-top: var(--tone-section-gap);
      padding-top: var(--tone-space-5);
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--tone-space-6);
    }
    .drawer-links {
      display: grid;
    }
    .drawer-links a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: var(--tone-control-height);
      padding: var(--tone-space-3) 0;
      border-bottom: 1px solid var(--border);
      font-size: var(--tone-subtitle-size);
      text-decoration: none;
    }
    .drawer-links span {
      font-size: var(--tone-caption-size);
      color: var(--fg-dim);
    }
    @media (max-width: 1000px) {
      .home-hero {
        gap: var(--tone-space-5);
      }
      .studio-strip {
        gap: var(--tone-space-3);
      }
      .recent-writing {
        gap: var(--tone-space-5);
      }
    }
    @media (max-width: 700px) {
      .home-hero {
        grid-template-columns: 1fr;
        gap: var(--tone-space-6);
      }
      .jarvis-highlight {
        align-items: flex-start;
        flex-direction: column;
      }
      .home-art {
        max-width: var(--tone-flow-max);
        width: 100%;
        margin: auto;
      }
      .studio-strip {
        flex-wrap: wrap;
        justify-content: start;
        gap: var(--tone-space-2) var(--tone-space-4);
        margin-bottom: var(--tone-space-6);
      }
      .studio-strip > span:first-child {
        width: 100%;
      }
      .spaces,
      .recent-writing,
      .explore-more {
        grid-template-columns: 1fr;
      }
      .writing-section {
        margin-bottom: var(--tone-space-6);
      }
      .space h3 {
        margin-top: var(--tone-space-3);
      }
      .space-bottom {
        padding-top: var(--tone-space-4);
      }
      .recent-writing {
        gap: var(--tone-space-6);
      }
      .explore-more {
        margin-top: var(--tone-space-6);
      }
      .drawer-links a {
        font-size: var(--tone-body-size);
      }
      .desktop-break {
        display: none;
      }
    }
  </style>
</Layout>

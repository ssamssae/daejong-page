---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import ActivityCard from "../components/ActivityCard.astro";
import { getCollection } from "astro:content";
import { apps, saas, tools, ebooks } from "../data/products";

const sortedWorklog = (await getCollection("worklog")).sort(
  (a, b) =>
    b.data.date.localeCompare(a.data.date) ||
    (b.data.version ?? "").localeCompare(a.data.version ?? ""),
);
const seenWorklogDates = new Set<string>();
const allWorklog = sortedWorklog.filter((post) => {
  if (seenWorklogDates.has(post.data.date)) return false;
  seenWorklogDates.add(post.data.date);
  return true;
});
const recentWorklog = allWorklog.slice(0, 5);

const epNum = (entry) => parseInt(String(entry.id).replace(/\D/g, ""), 10) || 0;
const allNewsletter = (await getCollection("newsletter")).sort(
  (a, b) => epNum(b) - epNum(a),
);
const recentNewsletter = allNewsletter.slice(0, 4);

const allInsights = (await getCollection("insights")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const recentInsights = allInsights.slice(0, 4);

const total = apps.length + tools.length + saas.length + ebooks.length;
const spaces = [
  {
    href: "/worklog/",
    label: "01 / BUILD LOG",
    title: "만드는 날들",
    desc: "오늘 만든 것과 고친 것. 작은 진전이 쌓이는 기록.",
    count: allWorklog.length + "일의 기록",
  },
  {
    href: "/newsletter/",
    label: "02 / LETTERS",
    title: "과정에서 건진 이야기",
    desc: "혼자 일하며 배우는 출시, 자동화, 그리고 시행착오.",
    count: allNewsletter.length + "통의 편지",
  },
  {
    href: "/insights/",
    label: "03 / INSIGHTS",
    title: "다음 생각의 재료",
    desc: "영상과 글에서 얻은 배움을 다음 작업으로 연결합니다.",
    count: allInsights.length + "개의 노트",
  },
];
---

<Layout
  title="강대종의 작업장 — 마이너스베타스튜디오"
  description="작은 아이디어를 쓸모 있는 제품으로. 강대종이 만드는 앱, 도구, 웹 서비스와 매일의 작업 기록을 만나보세요."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-copy">
      <p class="eyebrow">AN INDEPENDENT DIGITAL WORKSHOP</p><h1 id="home-title">
        만들고, 고치고,<br />기록합니다<span>.</span>
      </h1><p class="lead">
        강대종이 제품을 만들며 남긴 작업 기록입니다.<br />무엇을 고쳤고, 어디서 막혔고,<br class="desktop-break" /> 무엇을 배웠는지 공개된 글로 읽어보세요.
      </p><div class="hero-actions">
        <a class="button primary" href="/worklog/"
          >최근 작업 읽기 <span aria-hidden="true">↗</span></a
        ><a class="button" href="/newsletter/"
          >뉴스레터 읽기 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="home-art">
      <a class="workbench-note" href={`/newsletter/${recentNewsletter[0].id}/`}><span>가장 최근의 이야기 · {recentNewsletter[0].data.date}</span><strong>{recentNewsletter[0].data.title}</strong><p>{recentNewsletter[0].data.summary}</p><b>과정 읽기 ↗</b></a><div class="home-art-note">
        <span class="note-dot"></span><span>지금 이 작업장에서</span><strong
          >{total}개의 제품이 자라고 있어요.</strong>
      </div><span class="hand-note" aria-hidden="true"
        >small ideas, real things.</span>
    </div>
  </section>
  <div class="studio-strip">
    <span>MINUS BETA STUDIO</span><span>모바일 앱 <b>{apps.length}</b></span
    ><span>웹 서비스 <b>{saas.length}</b></span><span
      >오픈소스 <b>{tools.length}</b></span
    ><span>전자책 <b>{ebooks.length}</b></span>
  </div>
  <aside class="workshop-purpose"><p>쓸 제품을 찾고 계신가요? 제품 목록에서 기능과 실제 화면을 살펴보세요.</p><a href="/products/">모든 제품 보기 ↗</a><a href="https://founder.kangdaejong.com/">만드는 사람 소개 ↗</a></aside>
  <section class="writing-section" aria-labelledby="writing-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">THE WORK BEHIND THE WORK</p><h2 id="writing-title">
          결과만큼, 과정도 남깁니다.
        </h2>
      </div><p>잘된 일도, 막다른 길도.<br />다음 시작을 위한 기록들입니다.</p>
    </div><div class="spaces">
      {
        spaces.map((space) => (
          <a class="space" href={space.href}>
            <>
              <span class="space-label">{space.label}</span>
              <h3>{space.title}</h3>
              <p>{space.desc}</p>
              <span class="space-bottom">
                {space.count}
                <b aria-hidden="true">↗</b>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="recent-writing" aria-label="최근 기록">
    <div>
      <div class="recent-head">
        <p class="eyebrow">FROM THE WORKSHOP</p><a href="/worklog/"
          >작업일지 전체 ↗</a>
      </div><PostList posts={recentWorklog} base="/worklog" />
    </div><div>
      <div class="recent-head">
        <p class="eyebrow">LETTERS & THOUGHTS</p><a href="/newsletter/"
          >뉴스레터 전체 ↗</a>
      </div><PostList posts={recentNewsletter} base="/newsletter" />
    </div>
  </section>
  <ActivityCard />
  <section class="explore-more" aria-labelledby="explore-title">
    <div>
      <p class="eyebrow">OPEN NOTEBOOK</p><h2 id="explore-title">
        작업장의 다른 서랍들.
      </h2>
    </div><div class="drawer-links">
      <a href="/system/">시스템 <span>작업을 지탱하는 구조 ↗</span></a><a
        href="/lab/">실험실 <span>궁금해서 해본 것들 ↗</span></a
      ><a href="/timeline.html/">타임라인 <span>처음부터 지금까지 ↗</span></a>
    </div>
  </section>
  <style>
    .workbench-note{display:flex;flex-direction:column;gap:20px;padding:38px;background:#fdfcf8;border:1px solid var(--border);border-radius:16px;color:inherit;text-decoration:none}.workbench-note>span{font-size:12px;color:var(--fg-dim)}.workbench-note>strong{font-size:clamp(24px,3vw,38px);line-height:1.45;word-break:keep-all}.workbench-note p{font-size:14px;line-height:1.85;color:var(--fg-dim)}.workbench-note b{font-size:13px;color:var(--accent-cta)}.workshop-purpose{display:flex;flex-wrap:wrap;gap:14px 24px;padding:24px 0 40px;font-size:14px;line-height:1.8}.workshop-purpose p{flex:1 1 100%}.workshop-purpose a{min-height:44px;color:var(--accent-cta)}
    .home-hero {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
      gap: 70px;
      padding: 30px 0 68px;
    }
    .home-copy h1 {
      font-size: clamp(42px, 5.5vw, 76px);
      line-height: 1.2;
      letter-spacing: -0.06em;
    }
    .home-copy h1 > span {
      color: var(--accent);
    }
    .home-copy .lead {
      font-size: 16px;
      margin-top: 28px;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 30px;
    }
    .home-art {
      position: relative;
      padding: 16px 18px 30px;
      background: #eae6dc;
      border: 1px solid #ded9ce;
      border-radius: 160px 160px 14px 14px;
      transform: rotate(3deg);
    }
    .home-art :global(.product-art) {
      height: 330px;
      border-radius: 145px 145px 9px 9px;
    }
    .home-art :global(.art-caption) {
      display: none;
    }
    .home-art-note {
      position: relative;
      display: grid;
      grid-template-columns: 10px 1fr;
      background: var(--bg);
      padding: 17px 20px;
      margin: -14px -32px 0 20px;
      box-shadow: var(--shadow-pop);
      border: 1px solid var(--border);
      border-radius: 8px;
      transform: rotate(-6deg);
      gap: 2px 10px;
      font-size: 11px;
    }
    .home-art-note strong {
      grid-column: 2;
      font-size: 13px;
      font-weight: 600;
    }
    .note-dot {
      background: #608352;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      margin-top: 7px;
    }
    .hand-note {
      position: absolute;
      left: 24px;
      bottom: -29px;
      font:
        italic 18px Georgia,
        serif;
      color: var(--accent);
      transform: rotate(-4deg);
    }
    .studio-strip {
      display: flex;
      gap: 28px;
      justify-content: space-between;
      align-items: center;
      border-block: 1px solid var(--border);
      padding: 21px 0;
      margin-bottom: 80px;
      font-size: 12px;
      color: var(--fg-dim);
    }
    .studio-strip > span:first-child {
      font: 10px var(--mono);
      letter-spacing: 0.06em;
    }
    .studio-strip b {
      font-weight: 600;
      color: var(--fg);
      margin-left: 10px;
    }
    .home-selected,
    .writing-section {
      margin-bottom: 80px;
    }
    .home-products {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
    .home-product {
      text-decoration: none;
      display: block;
      min-width: 0;
    }
    .home-product h3 {
      display: flex;
      justify-content: space-between;
      margin: 17px 0 8px;
      font-size: 23px;
    }
    .home-product h3 span {
      font-weight: 400;
    }
    .home-product > p {
      font-size: 13px;
      line-height: 1.8;
    }
    .spaces {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }
    .space {
      display: flex;
      flex-direction: column;
      padding: 30px;
      background: var(--bg);
      text-decoration: none;
      transition: background 0.2s;
    }
    .space:hover {
      background: var(--bg-elev);
    }
    .space-label {
      font: 10px var(--mono);
      letter-spacing: 0.07em;
      color: var(--accent);
    }
    .space h3 {
      margin: 30px 0 14px;
      font-size: 25px;
    }
    .space p {
      font-size: 14px;
      line-height: 1.8;
    }
    .space-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      padding-top: 35px;
      font-size: 11px;
      color: var(--fg-mute);
    }
    .space-bottom b {
      font-size: 23px;
      font-weight: 400;
      color: var(--fg);
    }
    .recent-writing {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 50px;
      margin-bottom: 70px;
    }
    .recent-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--border);
    }
    .recent-head a {
      font-size: 11px;
      text-decoration: none;
    }
    .explore-more {
      margin-top: 80px;
      padding-top: 32px;
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .drawer-links {
      display: grid;
    }
    .drawer-links a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 17px 0;
      border-bottom: 1px solid var(--border);
      font-size: 19px;
      text-decoration: none;
    }
    .drawer-links span {
      font-size: 12px;
      color: var(--fg-dim);
    }
    @media (max-width: 1000px) {
    .home-hero {
        gap: 36px;
      }
      .home-art-note {
        margin-right: -15px;
      }
      .home-products {
        gap: 18px;
      }
      .space {
        padding: 23px;
      }
      .space h3 {
        font-size: 22px;
      }
      .studio-strip {
        gap: 18px;
      }
      .recent-writing {
        gap: 30px;
      }
    }
    @media (max-width: 700px) {
    .home-hero {
        grid-template-columns: 1fr;
        gap: 48px;
        padding-top: 12px;
      }
      .home-copy h1 {
        font-size: clamp(38px, 9vw, 62px);
      }
      .home-art {
        max-width: 420px;
        width: calc(100% - 30px);
        margin: auto;
      }
      .studio-strip {
        flex-wrap: wrap;
        justify-content: start;
        gap: 12px 24px;
        margin-bottom: 50px;
      }
      .studio-strip > span:first-child {
        width: 100%;
      }
      .home-products,
      .spaces,
      .recent-writing,
      .explore-more {
        grid-template-columns: 1fr;
      }
      .home-products {
        gap: 34px;
      }
      .home-selected,
      .writing-section {
        margin-bottom: 50px;
      }
      .space {
        padding: 28px;
      }
      .space h3 {
        margin-top: 20px;
      }
      .space-bottom {
        padding-top: 24px;
      }
      .recent-writing {
        gap: 45px;
      }
      .explore-more {
        margin-top: 50px;
      }
      .drawer-links a {
        font-size: 17px;
      }
      .drawer-links span {
        font-size: 11px;
      }
      .desktop-break {
        display: none;
      }
    }
  </style>
</Layout>

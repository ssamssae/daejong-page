---
import ArticleFrame from "../../components/ArticleFrame.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const posts = await getCollection("insights");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout
  title={`${post.data.title} — 인사이트`}
  description={post.data.summary ?? post.data.title}
>
  <ArticleFrame
    title={post.data.title}
    summary={post.data.summary}
    date={post.data.date}
    version={post.data.version}
    headings={headings}
    label="인사이트"
    base="/insights/"><Content /></ArticleFrame
  >
</Layout>

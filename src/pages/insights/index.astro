---
import Archive from "../../components/Archive.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("insights")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
---

<Layout
  title="인사이트 — 마이너스베타스튜디오"
  description="읽고, 보고, 생각한 것들. 다음 작업에 써먹을 배움을 내 언어로 남깁니다."
>
  <Archive
    posts={posts}
    base="/insights"
    title="인사이트"
    eyebrow="IDEAS WORTH KEEPING"
    description="읽고, 보고, 생각한 것들. 다음 작업에 써먹을 배움을 내 언어로 남깁니다."
  />
</Layout>

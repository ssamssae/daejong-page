---
import SystemGuide from '../components/SystemGuide.astro';
import index from '../../public/knowhow/index.json';
const entries = [...index.entries].sort((a,b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title,'ko'));
const categories = [...new Set(entries.map(x => x.category).filter(Boolean))].sort();
const latestDate = entries[0]?.date || '—';
---
<SystemGuide collectionCount={entries.length} pageKey={"knowhow"} label={"노하우"} eyebrow={"FIELD NOTES / KEEP WHAT WORKS"} title={"한 번의 해결을,\n다음 작업의 시작으로."} lead={"개발과 AI 협업에서 배운 판단 기준과 시행착오를 모았습니다. 원문은 당시의 기록으로 보존하고, 현재 운영 설명과 구분해 읽습니다."} motif={"Solve.\nWrite. Reuse."} steps={["문제와 원인 남기기", "다시 쓸 수 있는 해법 정리", "적용 전에 현재 환경 확인"]}>
<section class="guide-section"><div class="guide-heading"><div><p class="guide-kicker">01 / KEEP THE CONTEXT</p><h2>기록을 읽는 세 가지 기준.</h2></div><p></p></div><div class="guide-grid"><article class="guide-card"><span class="guide-kicker">01</span><h3>그때의 조건</h3><p>작성일과 당시 도구 구성을 함께 봅니다. 과거의 역할 이름이나 절차가 지금도 유효하다고 가정하지 않습니다.</p></article><article class="guide-card"><span class="guide-kicker">02</span><h3>재사용할 원리</h3><p>특정 명령보다 왜 그 방법이 필요했는지를 찾습니다. 현재 프로젝트에 맞는 부분만 적용합니다.</p></article><article class="guide-card"><span class="guide-kicker">03</span><h3>검증할 결과</h3><p>해법을 적용한 뒤에는 원래 문제가 해결됐는지 다시 확인합니다. 같은 증상도 원인은 달라질 수 있습니다.</p></article></div></section><section class="guide-section" id="archive"><div class="guide-heading"><div><p class="guide-kicker">02 / SEARCH THE ARCHIVE</p><h2>필요할 때 다시 꺼내보기.</h2></div><p>{entries.length}개의 원문 · 가장 최근 기록 {latestDate}<br/>페이지 정리일과 원문 작성일은 서로 다릅니다.</p></div>
<form class="guide-search" role="search" id="note-filter"><label>키워드 검색<input id="note-query" type="search" placeholder="예: 검증, Flutter, launchd"/></label><label>카테고리<select id="note-category"><option value="">전체</option>{categories.map(c => <option value={c}>{c}</option>)}</select></label><button type="reset">초기화</button></form>
<p class="guide-result" id="note-status" aria-live="polite">전체 {entries.length}건</p>
<div class="guide-note-list">{entries.map(entry => <article class="guide-card" data-note data-category={entry.category || ''} data-search={[entry.title,entry.summary,entry.category,...(entry.tags || [])].join(' ').toLocaleLowerCase('ko-KR')}><time datetime={entry.date}>{entry.date} · {entry.category || '미분류'}</time><h3>{entry.title}</h3><p>{entry.summary}</p><a href={'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/'+encodeURIComponent(entry.file?.trim() || entry.slug + '.md')}>원문 보기 ↗</a></article>)}</div><p id="note-empty" hidden>일치하는 기록이 없습니다. 검색어를 줄이거나 카테고리를 전체로 바꿔보세요.</p></section>
<script>
const form = document.querySelector<HTMLFormElement>('#note-filter');
const query = document.querySelector<HTMLInputElement>('#note-query');
const category = document.querySelector<HTMLSelectElement>('#note-category');
const notes = [...document.querySelectorAll<HTMLElement>('[data-note]')];
function filterNotes() {
  const q = query?.value.trim().toLocaleLowerCase('ko-KR') || '';
  const c = category?.value || '';
  let count = 0;
  for (const note of notes) {
    note.hidden = !(note.dataset.search?.includes(q) && (!c || note.dataset.category === c));
    if (!note.hidden) count++;
  }
  const status = document.querySelector('#note-status');
  if (status) status.textContent = `${count} / ${notes.length}건`;
  const empty = document.querySelector<HTMLElement>('#note-empty');
  if (empty) empty.hidden = count !== 0;
}
form?.addEventListener('submit', event => event.preventDefault());
form?.addEventListener('input', filterNotes);
form?.addEventListener('change', filterNotes);
form?.addEventListener('reset', () => { if (query) query.value = ''; if (category) category.value = ''; filterNotes(); });
</script>
</SystemGuide>

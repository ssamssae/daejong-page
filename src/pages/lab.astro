---
import '../styles/hub.css';
import Layout from '../layouts/Layout.astro';
import experiments from '../data/lab-experiments.json';

const items = [
  {
    href: '/issues.html',
    kicker: 'POSTMORTEM',
    title: '이슈',
    desc: '발생했다 해결한 이슈와 혼선의 포스트모템. 증상, 원인, 조치, 예방을 남깁니다.',
    group: '운영 기록',
  },
  {
    href: '/dead-ends.html',
    kicker: 'DEAD ENDS',
    title: '막다른 길',
    desc: '제품이 되지 못했거나 구조적으로 막힌 시도들. 같은 벽을 다시 치지 않기 위한 기록입니다.',
    group: '운영 기록',
  },
  {
    href: '/ai-glossary.html',
    kicker: 'GLOSSARY',
    title: 'AI 용어집',
    desc: '영상과 작업 중 나온 Grok·Claude·Codex·Cursor·로컬 LLM 용어를 1인 개발자 맥락으로 정리합니다.',
    group: '지식 노트',
  },
  {
    href: '/vibecoding.html',
    kicker: 'METHOD',
    title: '바이브코딩',
    desc: '슬래시 커맨드에서 여러 노드와 브릿지를 쓰기까지, 개발 방식이 바뀐 과정을 읽습니다.',
    group: '지식 노트',
  },
  {
    href: '/habits.html',
    kicker: 'HABITS',
    title: '습관',
    desc: '세션 운영, 완료 마킹, 보고, 시간 표기처럼 반복해서 지켜야 하는 작은 습관들입니다.',
    group: '지식 노트',
  },
  {
    href: '/timeline.html',
    kicker: 'TIMELINE',
    title: '타임라인',
    desc: '2026년 4월 첫 코드부터 제품과 작업 도구가 늘어난 과정을 남긴 공개 연대기입니다.',
    group: '지식 노트',
  },
  {
    href: '/stock.html',
    kicker: 'STOCK',
    title: '주식',
    desc: '투자 관련 메모와 관찰 기록입니다.',
    group: '실험',
  },
  {
    href: '/sise.html',
    kicker: 'MARKET',
    title: '시세',
    desc: '시세 관련 실험과 데이터 관찰을 모아둡니다.',
    group: '실험',
  },
  {
    href: '/sorry/',
    kicker: 'LOG',
    title: '반성문',
    desc: '에이전트가 실수한 순간을 기록하고, 같은 실수를 줄이기 위한 흔적을 남깁니다.',
    group: '운영 기록',
  },
];

const featured = [items[0], items[1], items[3]];
const groups = ['운영 기록', '지식 노트', '실험'].map((label) => ({
  label,
  items: items.filter((item) => item.group === label),
}));

const heroSummary = `${items.length}개 아카이브 · 비교 실험 ${experiments.length}건 · 측정 결과와 한계 함께 읽기`;

const principles = [
  ['실패도 자산으로 남깁니다.', '접은 시도는 지우지 않고, 다음 작업에서 같은 비용을 다시 내지 않게 보관합니다.'],
  ['잡학은 연결될 때까지 둡니다.', '지금은 제품이 아니어도 용어, 습관, 실험은 다음 빌드의 재료가 됩니다.'],
  ['공개 가능한 것만 씁니다.', '실제 운영 세부와 민감한 정보는 제외하고, 배울 수 있는 구조만 남깁니다.'],
];

const nowCards = experiments.map(item => ({ href: `/experiments/#${item.id}`, kicker: item.status, title: item.title, desc: item.rows.find(row => row.label === '결과')?.text }));
---
<Layout title="실험실 — 마이너스베타스튜디오" description="실제 비교 실험의 결과와 한계, 운영 사고의 교훈, 접은 시도의 판단을 모은 공개 기록입니다.">
  <div class="lab-index">
    <section class="lab-hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <p class="eyebrow">LAB NOTEBOOK</p>
        <h1 id="page-title">실험실</h1>
        <p class="lead">
          제품으로 바로 묶이지 않는 잡학, 실험, 포스트모템, 접은 시도를 모아둡니다.
          성공한 것보다 다시 같은 길을 밟지 않게 만드는 기록에 가깝습니다.
        </p>
      </div>
      <dl class="hero-stats" aria-label="lab 요약">
        <div>
          <dt>문서</dt>
          <dd>{items.length}</dd>
        </div>
        <div>
          <dt>묶음</dt>
          <dd>{groups.length}</dd>
        </div>
        <div>
          <dt>원칙</dt>
          <dd>공개</dd>
        </div>
      </dl>
      <p class="hero-summary">{heroSummary}</p>
    </section>

    <section class="now-section" aria-labelledby="now-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">TESTED</p>
          <h2 id="now-title">직접 비교해 얻은 결과</h2>
        </div>
        <p>2026-09-21 실험 기록 · 편집 확인 2026-09-23. 성공 수치와 측정하지 못한 것을 함께 공개합니다.</p>
      </div>

      <div class="module-grid">
        {nowCards.map((item, index) => (
          <a class="module-card" href={item.href}>
            <span class="card-topline">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{item.kicker}</span>
            </span>
            <strong>{item.title}</strong>
            <span>{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="featured-section" aria-labelledby="featured-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">START HERE</p>
          <h2 id="featured-title">먼저 볼 기록</h2>
        </div>
        <p>운영 사고, 접은 길, 바이브코딩 변천사를 먼저 보면 이 lab이 왜 필요한지 빠르게 보입니다.</p>
      </div>

      <div class="featured-grid">
        {featured.map((item, index) => (
          <a class={index === 0 ? 'feature-card primary' : 'feature-card'} href={item.href}>
            <span class="card-topline">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{item.kicker}</span>
            </span>
            <strong>{item.title}</strong>
            <span>{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="archive-section" aria-labelledby="archive-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">INDEX</p>
          <h2 id="archive-title">전체 lab</h2>
        </div>
        <p>성격별로 나눠 필요한 기록으로 바로 들어갈 수 있게 정리했습니다.</p>
      </div>

      <div class="archive-list">
        {groups.map((group) => (
          <section class="group-block" aria-labelledby={`group-${group.label}`}>
            <header>
              <h3 id={`group-${group.label}`}>{group.label}</h3>
              <span>{group.items.length}개</span>
            </header>
            <ol>
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>
                    <span>{item.kicker}</span>
                    <strong>{item.title}</strong>
                    <em>{item.desc}</em>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </section>

    <section class="principle-section" aria-labelledby="principle-title">
      <div class="section-head compact">
        <div>
          <p class="eyebrow">WHY KEEP IT</p>
          <h2 id="principle-title">lab에 남기는 기준</h2>
        </div>
      </div>

      <dl class="principle-list">
        {principles.map(([term, desc]) => (
          <div>
            <dt>{term}</dt>
            <dd>{desc}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>


</Layout>

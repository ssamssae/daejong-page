---
import ArticleFrame from "../../components/ArticleFrame.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import NlNewsletterHops from "../../components/NlNewsletterHops.astro";
import { campaignFromPath } from "../../lib/nl-allowlist.mjs";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const posts = await getCollection("newsletter");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const campaign = String(
  post.data.version || campaignFromPath(post.id) || post.id,
).toLowerCase();
---

<Layout
  title={`${post.data.title} — 뉴스레터`}
  description={post.data.summary ?? post.data.title}
>
  <ArticleFrame
    title={post.data.title}
    summary={post.data.summary}
    date={post.data.date}
    version={post.data.version}
    headings={headings}
    label="뉴스레터"
    base="/newsletter/"><Content /></ArticleFrame
  >
  <NlNewsletterHops campaign={campaign} />
</Layout>

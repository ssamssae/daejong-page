---
import Archive from "../../components/Archive.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const episodeNumber = (entry: { id: string; data: { version?: string } }) =>
  parseInt(String(entry.data.version ?? entry.id).replace(/\D/g, ""), 10) || 0;

const posts = (await getCollection("newsletter")).sort(
  (a, b) => episodeNumber(b) - episodeNumber(a),
);
---

<Layout
  title="뉴스레터 — 마이너스베타스튜디오"
  description="혼자 만드는 일의 기쁨과 어려움. 출시와 자동화, 그 사이에서 배운 것들을 편지로 전합니다."
>
  <Archive
    posts={posts}
    base="/newsletter"
    title="뉴스레터"
    eyebrow="LETTERS FROM THE WORKSHOP"
    description="혼자 만드는 일의 기쁨과 어려움. 출시와 자동화, 그 사이에서 배운 것들을 편지로 전합니다."
  />
</Layout>

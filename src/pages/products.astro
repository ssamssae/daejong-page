---
import Layout from "../layouts/Layout.astro";
import NlVisitBeacon from "../components/NlVisitBeacon.astro";
import ProductExamples from "../components/ProductExamples.astro";
import IptaDemo from "../components/IptaDemo.astro";
import BridgeDemo from "../components/BridgeDemo.astro";
import ProductCard from "../components/ProductCard.astro";
import { apps, saas, tools, ebooks, retiredProducts, productCounts } from "../data/products";
const categories = [
  { kind: "saas", label: "웹 서비스", items: saas },
  { kind: "app", label: "모바일 앱", items: apps },
  { kind: "tool", label: "오픈소스", items: tools },
  { kind: "ebook", label: "전자책", items: ebooks },
].filter(category => category.items.length > 0);

---

<Layout
  bodyClass="catalog-page"
  title="제품 — 마이너스베타스튜디오"
  description="현재 제공하는 모바일 앱과 오픈소스 도구, 서비스·판매 종료 기록을 확인하세요."
>
  <section class="studio-hero" aria-labelledby="page-title"><p class="studio-label">직접 만들어 쓰는 도구들</p><h1 id="page-title">작은 제품,<br/><span>쓸모 있는 일상.</span></h1><p class="studio-lead">기록하고, 연결하고, 새로운 시작을 돕는 앱과 공개 도구예요.</p></section>
  <NlVisitBeacon />
  <section
    id="catalog"
    class="catalog"
    aria-labelledby="catalog-title"
    data-catalog
  >
    <div class="section-head">
      <div>
        <p class="eyebrow mb-eyebrow">생활에 맞는 앱 찾기</p><h2
          id="catalog-title"
        >
          현재 제공하는 제품
        </h2>
      </div><p>필요한 순간에, 가볍게 꺼내 쓰세요.</p>
    </div>
    <div class="catalog-toolbar" data-catalog-controls hidden>
      <div class="filters" role="group" aria-label="제품 종류">
        <button type="button" class="mb-option" data-filter="all" aria-pressed="true"
          >전체 <span>{productCounts.total}</span></button
        >{
          categories.map((c) => (
            <button type="button" class="mb-option" data-filter={c.kind} aria-pressed="false">
              {c.label} <span>{c.items.length}</span>
            </button>
          ))
        }
      </div><label class="search-box"
        ><svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4 4"
          ></path></svg
        ><span class="sr-only">제품 검색</span><input
          class="mb-input"
          type="search"
          placeholder="어떤 제품을 찾으세요?"
          data-catalog-search
          autocomplete="off"
        /></label>
    </div>
    <div class="catalog-meta">
      <p data-catalog-count role="status" aria-live="polite">
        {productCounts.total}개의 제품
      </p><span>작게 시작해, 꾸준히 다듬는 중</span>
    </div>
    <div class="catalog-grid">
      {
        categories.flatMap((category) =>
          category.items.map((item, index) => (
            <ProductCard
              item={item}
              index={index}
              kind={category.kind}
              label={category.label}
            />
          )),
        )
      }
    </div>
    <div class="empty-state" data-catalog-empty hidden>
      <span aria-hidden="true">⌕</span><h3>아직 찾는 제품이 없네요.</h3><p>
        다른 검색어를 입력하거나 전체 제품을 둘러보세요.
      </p><button type="button" class="mb-btn mb-btn--secondary" data-catalog-reset
        >전체 제품 보기</button>
    </div>
    <noscript
      ><p class="no-script">
        전체 제품을 표시했어요. 검색과 분류 기능은 JavaScript를
        켜면 이용할 수 있어요.
      </p></noscript
    >
  </section>
  <section class="retired-products" id="retired-products" aria-labelledby="retired-title">
    <h2 id="retired-title">종료한 제품과 서비스</h2>
    <p>2026년 10월 3일 기준이에요. 앱은 신규 배포를 종료했으며, 기존 설치본의 데이터 삭제를 뜻하지 않아요. 무료 실습 양식도 2026년 10월 4일 공개 제공을 종료했어요.</p>
    <ul>{retiredProducts.map(item => <li class="mb-row"><strong>{item.name}</strong><span>{item.status} · <time datetime={item.date}>{item.date}</time></span></li>)}</ul>
  </section>
  <details class="product-demos"><summary>제품 화면과 사용 예시</summary><ProductExamples /><IptaDemo /><BridgeDemo /></details>
  <p class="comparison-note">비용·지원·가입 정보 확인: 2026-09-22. 운영·종료 상태 확인: 2026-10-04. 스토어별 인앱 구매와 연결 서비스 요금은 해당 안내를 확인하세요.</p>
  <aside class="making-note">
    <span class="note-star" aria-hidden="true">✳</span><div>
      <h2>완성보다, 계속 만드는 마음.</h2><p>
        제품이 만들어지는 과정과 시행착오도 함께 남겨요.
      </p>
    </div><a href="/worklog/" class="mb-link"
      >작업 기록 읽기 <span aria-hidden="true">↗</span></a>
  </aside>
  <script>
    import { initCatalog } from "../scripts/catalog";
    document
      .querySelectorAll<HTMLElement>("[data-catalog]")
      .forEach(initCatalog);
  </script>
  <style>
    /* T-261024-058: 고르는 칸(.mb-option)·입력칸(.mb-input)·버튼(.mb-btn)·글 링크(.mb-link)·이름·값 줄(.mb-row)·눈썹 글(.mb-eyebrow)은
       회사홈 공용 톤 파일의 부품이 정하고, 남는 배치 간격·글자 크기는 공용 톤 값(--tone-*)만 쓴다 — 직접 숫자 0(verify-tone-copies).
       첫 화면(.studio-hero·.studio-label·.studio-lead)은 공용 studio-page.css 가 정한다.
       마크업에 없던 옛 규칙(.collection-hero·.hero-note·.collection-mark·.selected-*·.art-link 등)은 지웠다. */
    .retired-products {
      margin-top: var(--tone-section-gap);
      padding-top: var(--tone-space-4);
      border-top: 1px solid var(--border);
    }
    .retired-products > p {
      font-size: var(--tone-label-size);
      line-height: var(--tone-label-line);
      margin: var(--tone-space-2) 0;
      color: var(--fg-mute);
    }
    .retired-products ul {
      list-style: none;
      padding: 0;
    }
    .retired-products li {
      flex-wrap: wrap;
    }
    .retired-products li span {
      color: var(--fg-mute);
      font-size: var(--tone-caption-size);
    }
    .catalog {
      scroll-margin-top: var(--tone-space-4);
    }
    .catalog-toolbar {
      display: flex;
      justify-content: space-between;
      gap: var(--tone-space-4);
      align-items: center;
      padding: var(--tone-space-3) 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .filters {
      display: flex;
      gap: var(--tone-space-1);
      flex-wrap: wrap;
    }
    .filters button {
      white-space: nowrap;
    }
    .filters button span {
      font: var(--tone-weight) var(--tone-caption-size) / var(--tone-caption-line) var(--mono);
      opacity: 0.7;
    }
    .search-box {
      position: relative;
      display: flex;
      align-items: center;
      color: var(--fg-mute);
      min-width: 240px;
    }
    .search-box svg {
      position: absolute;
      left: var(--tone-control-padding);
      pointer-events: none;
    }
    .search-box input {
      padding-left: var(--tone-space-6);
    }
    .catalog-meta {
      display: flex;
      justify-content: space-between;
      margin: var(--tone-space-3) 0;
      color: var(--fg-mute);
      font-size: var(--tone-caption-size);
    }
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--tone-space-2);
    }
    .empty-state {
      text-align: center;
      padding: var(--tone-section-gap) var(--tone-space-3);
      border: 1px dashed var(--border);
      border-radius: var(--tone-radius-card);
    }
    .empty-state > span {
      font-size: var(--tone-display-size);
      color: var(--fg-mute);
    }
    .empty-state h3 {
      margin: var(--tone-space-2) 0;
    }
    .empty-state p {
      font-size: var(--tone-label-size);
      margin-bottom: var(--tone-space-4);
    }
    .making-note {
      margin-top: var(--tone-space-5);
      display: flex;
      align-items: center;
      gap: var(--tone-space-3);
      padding: var(--tone-space-4) 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .note-star {
      display: none;
    }
    .making-note p {
      font-size: var(--tone-label-size);
      margin-top: var(--tone-space-1);
    }
    .making-note a {
      margin-left: auto;
      white-space: nowrap;
    }
    .no-script {
      margin-top: var(--tone-space-3);
      font-size: var(--tone-caption-size);
    }
    .product-demos {
      margin-top: var(--tone-space-5);
      border-block: 1px solid var(--border);
    }
    .product-demos > summary {
      padding: var(--tone-space-3) 0;
      min-height: var(--tone-control-height);
      cursor: pointer;
      font-size: var(--tone-label-size);
    }
    .comparison-note {
      font-size: var(--tone-caption-size);
      color: var(--fg-mute);
      margin: var(--tone-space-3) 0;
    }
    .catalog > .section-head {
      margin-bottom: var(--tone-space-4);
    }
    .catalog .eyebrow {
      display: none;
    }
    :global(body.catalog-page .site-main) {
      padding-top: 0;
    }
    @media (max-width: 1000px) {
      .catalog-toolbar {
        align-items: stretch;
        flex-direction: column;
        gap: var(--tone-space-2);
      }
      .search-box {
        width: 100%;
      }
      .catalog-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 640px) {
      .catalog-grid {
        grid-template-columns: 1fr;
      }
      .catalog-meta > span {
        display: none;
      }
      .making-note {
        flex-wrap: wrap;
        gap: var(--tone-space-2);
      }
      .making-note p {
        font-size: var(--tone-caption-size);
      }
      .making-note a {
        margin-left: 0;
      }
    }
  </style>
</Layout>

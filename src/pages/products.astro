---
import Layout from "../layouts/Layout.astro";
import ProductArt from "../components/ProductArt.astro";
import ProductCard from "../components/ProductCard.astro";
import { apps, saas, tools, ebooks, productCounts } from "../data/products";
const categories = [
  { kind: "saas", label: "웹 서비스", items: saas },
  { kind: "app", label: "모바일 앱", items: apps },
  { kind: "tool", label: "오픈소스", items: tools },
  { kind: "ebook", label: "전자책", items: ebooks },
];
const featured = [
  {
    item: saas[0],
    kind: "name",
    tag: "새로운 시작을 위해",
    title: "첫이름",
    desc: "처음 부를 이름에, 오래 간직할 의미를.",
  },
  {
    item: apps[0],
    kind: "diary",
    tag: "기록하는 일상을 위해",
    title: "한줄일기",
    desc: "거창하지 않아도 괜찮은, 하루 한 줄.",
  },
  {
    item: apps[1],
    kind: "memo",
    tag: "떠오르는 생각을 위해",
    title: "메모요",
    desc: "스치는 생각이 사라지기 전에.",
  },
];
---

<Layout
  title="제품 — 마이너스베타스튜디오"
  description="일상의 작은 불편에서 시작한 마이너스베타스튜디오의 앱, 웹 서비스, 오픈소스 도구와 전자책을 만나보세요."
>
  <section class="collection-hero" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">THE PRODUCT COLLECTION · MINUS BETA</p><h1
        id="page-title"
      >
        작은 제품,<br />쓸모 있는 일상<span class="title-dot">.</span>
      </h1><p class="hero-description">
        일상의 작은 불편에서 시작했습니다.<br />기록하고, 연결하고, 새로운
        시작을 돕는 것들을 만듭니다.
      </p>
    </div>
    <div class="hero-note">
      <span class="edition">INDEPENDENTLY MADE / SEOUL</span><div
        class="collection-mark"
        aria-hidden="true"
      >
        <span>mβ</span><i>작지만, 쓸모 있게.</i>
      </div><p>
        하나의 작업장에서 시작된<br /><strong
          >{productCounts.total}개의 작은 가능성.</strong>
      </p><a href="#catalog" class="hero-jump"
        >나에게 필요한 제품 찾기 <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="selected" aria-labelledby="selected-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">A FEW GOOD PLACES TO START</p><h2
          id="selected-title"
        >
          이런 것들을 만들고 있어요.
        </h2>
      </div><span class="section-index">SELECTED 01 — 03</span>
    </div>
    <div class="selected-grid">
      {
        featured.map((f, index) => (
          <article class="selected-card">
            <>
              <a
                class="art-link"
                href={f.item.links[0].url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${f.title} 바로가기 (새 창)`}
              >
                <ProductArt kind={f.kind} />
              </a>
              <div class="selected-info">
                <>
                  <span class="selected-tag">{f.tag}</span>
                  <h3>
                    <a
                      href={f.item.links[0].url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {f.title}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p>{f.desc}</p>
                  <div class="selected-links">
                    {f.item.links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${f.title} — ${link.label} (새 창)`}
                      >
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section
    id="catalog"
    class="catalog"
    aria-labelledby="catalog-title"
    data-catalog
  >
    <div class="section-head">
      <div>
        <p class="eyebrow">FIND YOUR EVERYDAY COMPANION</p><h2
          id="catalog-title"
        >
          모든 제품
        </h2>
      </div><p>필요한 순간에, 가볍게 꺼내 쓰세요.</p>
    </div>
    <div class="catalog-toolbar" data-catalog-controls hidden>
      <div class="filters" role="group" aria-label="제품 종류">
        <button type="button" data-filter="all" aria-pressed="true"
          >전체 <span>{productCounts.total}</span></button
        >{
          categories.map((c) => (
            <button type="button" data-filter={c.kind} aria-pressed="false">
              {c.label} <span>{c.items.length}</span>
            </button>
          ))
        }
      </div><label class="search-box"
        ><svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4 4"
          ></path></svg
        ><span class="sr-only">제품 검색</span><input
          type="search"
          placeholder="어떤 제품을 찾으세요?"
          data-catalog-search
          autocomplete="off"
        /></label>
    </div>
    <div class="catalog-meta">
      <p data-catalog-count role="status" aria-live="polite">
        {productCounts.total}개의 제품
      </p><span>작게 시작해, 꾸준히 다듬는 중</span>
    </div>
    <div class="catalog-grid">
      {
        categories.flatMap((category) =>
          category.items.map((item, index) => (
            <ProductCard
              item={item}
              index={index}
              kind={category.kind}
              label={category.label}
            />
          )),
        )
      }
    </div>
    <div class="empty-state" data-catalog-empty hidden>
      <span aria-hidden="true">⌕</span><h3>아직 찾는 제품이 없네요.</h3><p>
        다른 검색어를 입력하거나 전체 제품을 둘러보세요.
      </p><button type="button" class="button" data-catalog-reset
        >전체 제품 보기</button>
    </div>
    <noscript
      ><p class="no-script">
        전체 제품을 표시했습니다. 검색과 분류 기능은 JavaScript를
        켜면 이용할 수 있습니다.
      </p></noscript
    >
  </section>
  <aside class="making-note">
    <span class="note-star" aria-hidden="true">✳</span><div>
      <h2>완성보다, 계속 만드는 마음.</h2><p>
        제품이 만들어지는 과정과 시행착오도 함께 남깁니다.
      </p>
    </div><a href="/worklog/" class="text-link"
      >작업 기록 읽기 <span aria-hidden="true">↗</span></a>
  </aside>
  <script>
    import { initCatalog } from "../scripts/catalog";
    document
      .querySelectorAll<HTMLElement>("[data-catalog]")
      .forEach(initCatalog);
  </script>
  <style>
    .collection-hero {
      display: grid;
      grid-template-columns: 1.65fr 1fr;
      gap: 48px;
      padding: 15px 0 64px;
      align-items: center;
    }
    .collection-hero h1 {
      font-size: clamp(44px, 6.7vw, 84px);
      line-height: 1.14;
      letter-spacing: -0.06em;
    }
    .title-dot {
      color: var(--accent-cta);
    }
    .hero-description {
      font-size: 16px;
      margin-top: 28px;
      line-height: 1.85;
      word-break: keep-all;
    }
    .hero-note {
      justify-self: end;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 285px;
      text-align: center;
    }
    .edition {
      font: 9px var(--mono);
      letter-spacing: 0.1em;
      color: var(--fg-mute);
    }
    .collection-mark {
      position: relative;
      display: grid;
      place-content: center;
      width: 170px;
      height: 155px;
      margin: 18px 0 15px;
      transform: rotate(-9deg);
      color: var(--accent-cta);
    }
    .collection-mark::before {
      content: "";
      position: absolute;
      inset: 0;
      border: 1px solid #c64b2e66;
      border-radius: 50%;
      transform: rotate(-25deg);
    }
    .collection-mark span {
      font:
        78px/0.9 Georgia,
        serif;
      letter-spacing: -11px;
      padding-right: 10px;
    }
    .collection-mark i {
      font-size: 10px;
      margin-top: 16px;
      font-style: normal;
    }
    .hero-note p {
      font-size: 13px;
      line-height: 1.7;
    }
    .hero-note strong {
      font-weight: 600;
      color: var(--fg);
    }
    .hero-jump {
      margin-top: 18px;
      font-size: 11px;
      text-decoration: none;
    }
    .hero-jump span {
      padding-left: 16px;
    }
    .selected {
      border-top: 1px solid var(--border);
      padding-top: 32px;
      margin-bottom: 80px;
    }
    .selected .section-head h2 {
      font-size: 26px;
    }
    .section-index {
      font: 10px var(--mono);
      color: var(--fg-mute);
    }
    .selected-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 24px;
    }
    .selected-card {
      min-width: 0;
    }
    .art-link {
      display: block;
      text-decoration: none;
      border-radius: 12px;
      transition: transform 0.2s;
    }
    .art-link:hover {
      transform: translateY(-4px);
    }
    .selected-info {
      padding: 19px 2px 0;
    }
    .selected-tag {
      font-size: 10px;
      color: var(--fg-mute);
    }
    .selected-info h3 {
      font-size: 24px;
      margin-top: 5px;
    }
    .selected-info h3 a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      text-decoration: none;
    }
    .selected-info h3 span {
      font-size: 21px;
      font-weight: 400;
    }
    .selected-info p {
      font-size: 13px;
      margin-top: 7px;
    }
    .selected-links {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin-top: 13px;
    }
    .selected-links a {
      font-size: 10px;
      text-decoration: none;
      min-height: 32px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .catalog {
      scroll-margin-top: 120px;
    }
    .catalog-toolbar {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      align-items: center;
      padding: 20px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .filters {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .filters button {
      min-height: 42px;
      padding: 9px 14px;
      border: 1px solid transparent;
      border-radius: 6px;
      background: transparent;
      font-size: 12px;
      white-space: nowrap;
    }
    .filters button span {
      font: 9px var(--mono);
      opacity: 0.7;
      margin-left: 4px;
    }
    .filters button:hover {
      background: var(--bg-elev);
    }
    .filters button[aria-pressed="true"] {
      background: var(--fg);
      color: var(--bg);
    }
    .search-box {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--fg-mute);
      padding: 0 13px;
      min-width: 240px;
      height: 43px;
      background: #fdfcf8;
      border: 1px solid var(--border);
      border-radius: 6px;
    }
    .search-box input {
      width: 100%;
      min-width: 0;
      border: 0;
      background: transparent;
      outline: none;
      font-size: 12px;
      color: var(--fg);
    }
    .search-box:focus-within {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
    .catalog-meta {
      display: flex;
      justify-content: space-between;
      margin: 20px 0;
      color: var(--fg-mute);
      font-size: 11px;
    }
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
    .empty-state {
      text-align: center;
      padding: 70px 20px;
      border: 1px dashed var(--border);
      border-radius: 12px;
    }
    .empty-state > span {
      font-size: 40px;
      color: var(--fg-mute);
    }
    .empty-state h3 {
      margin: 12px 0;
    }
    .empty-state p {
      font-size: 14px;
      margin-bottom: 24px;
    }
    .making-note {
      margin-top: 80px;
      display: flex;
      align-items: center;
      gap: 26px;
      padding: 32px;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .note-star {
      font-size: 58px;
      line-height: 1;
      color: var(--accent);
    }
    .making-note h2 {
      font-size: 22px;
    }
    .making-note p {
      font-size: 13px;
      margin-top: 7px;
    }
    .making-note a {
      margin-left: auto;
      white-space: nowrap;
    }
    .no-script {
      margin-top: 20px;
      font-size: 13px;
    }
    @media (max-width: 1000px) {
      .collection-hero {
        gap: 24px;
      }
      .hero-note {
        width: 240px;
      }
      .selected-grid {
        gap: 16px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .catalog-toolbar {
        align-items: stretch;
        flex-direction: column;
        gap: 14px;
      }
      .search-box {
        width: 100%;
      }
      .catalog-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 640px) {
      .collection-hero {
        grid-template-columns: 1fr;
        padding: 8px 0 40px;
        gap: 26px;
      }
      .collection-hero h1 {
        font-size: clamp(40px, 10.2vw, 64px);
      }
      .collection-hero .eyebrow {
        font-size: 9px;
      }
      .hero-note {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        text-align: left;
        border-top: 1px solid var(--border-soft);
        padding-top: 20px;
      }
      .edition,
      .collection-mark {
        display: none;
      }
      .hero-note p {
        font-size: 11px;
      }
      .hero-jump {
        font-size: 10px;
        margin-top: 0;
      }
      .hero-description {
        font-size: 14px;
        margin-top: 20px;
      }
      .selected .section-head h2 {
        font-size: 22px;
      }
      .section-index {
        display: none;
      }
      .selected-grid {
        grid-template-columns: 1fr;
        gap: 36px;
      }
      .selected-info {
        padding-top: 14px;
      }
      .selected {
        margin-bottom: 54px;
      }
      .selected-info h3 {
        font-size: 25px;
      }
      .selected-info p {
        font-size: 14px;
      }
      .selected-links a {
        font-size: 12px;
      }
      .catalog-grid {
        grid-template-columns: 1fr;
      }
      .filters {
        gap: 3px;
      }
      .filters button {
        padding: 9px 10px;
        font-size: 11px;
      }
      .catalog-meta > span {
        display: none;
      }
      .making-note {
        margin-top: 50px;
        flex-wrap: wrap;
        padding: 26px 0;
        gap: 18px;
      }
      .note-star {
        font-size: 40px;
      }
      .making-note h2 {
        font-size: 18px;
      }
      .making-note p {
        font-size: 12px;
      }
      .making-note a {
        margin-left: 58px;
        font-size: 12px;
      }
    }
  </style>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import knowhowIndex from '../../public/knowhow/index.json';

const knowhowCount = knowhowIndex.entries.length;

const stats = [
  { value: '3', label: 'Mac 작업 공간' },
  { value: '5', label: '공개 브릿지 저장소' },
  { value: '1', label: '작업별 책임 리드' },
  { value: '09.14', label: '내용 확인일' },
];

const principles = [
  {
    number: '01',
    title: '프롬프트보다 완료 조건',
    text: '무엇을 만들어야 하는지보다 어디까지 확인해야 끝인지 먼저 적는다. 구현·검증·배포를 서로 다른 단계로 본다.',
  },
  {
    number: '02',
    title: '한 작업에는 한 책임자',
    text: '여러 도구를 쓸 수 있어도 같은 일을 동시에 선점하지 않는다. 하나의 리드가 판단과 결과 회수를 끝까지 책임진다.',
  },
  {
    number: '03',
    title: '자신감보다 관측값',
    text: '파일을 바꿨다는 말보다 실행 중인 프로세스, 테스트 결과, 실제 기기와 공개 URL에서 읽은 값을 믿는다.',
  },
  {
    number: '04',
    title: '되돌리기 어려운 일은 마지막에',
    text: '삭제·결제·발송·스토어 제출·공개 머지는 준비와 검증을 마친 뒤 승인 범위 안에서 실행한다.',
  },
];

const loop = [
  {
    step: '01',
    label: 'REQUEST',
    title: '목표와 끝을 정한다',
    text: '사용자 요청에서 결과물, 완료 조건, 제외 범위를 분리한다. 모호함이 결과를 바꿀 때만 질문한다.',
    proof: 'goal · scope · done',
  },
  {
    step: '02',
    label: 'GROUND',
    title: '현재 상태를 먼저 읽는다',
    text: '기억보다 코드, 실행 중인 환경, 최신 정책과 외부 상태를 확인한다. 오래된 전제를 작업에 들이지 않는다.',
    proof: 'code · runtime · policy',
  },
  {
    step: '03',
    label: 'BUILD',
    title: '작은 변경으로 만든다',
    text: '작업 공간을 분리하고 직접 코드에서 반복한다. 병렬화는 독립적인 부분에만 쓰고 같은 파일 경합을 피한다.',
    proof: 'branch · diff · artifact',
  },
  {
    step: '04',
    label: 'VERIFY',
    title: '실패할 수 있는 축을 찌른다',
    text: '빌드만 보지 않는다. 회귀 테스트, 모바일 화면, 링크, 비밀정보, 런타임 값을 변경 위험에 맞게 검증한다.',
    proof: 'test · visual · runtime',
  },
  {
    step: '05',
    label: 'SHIP',
    title: '사용자 표면까지 확인한다',
    text: 'PR과 배포 성공 뒤에도 라이브 바이트와 공개 페이지를 다시 읽는다. 콘솔의 초록색을 출시 자체로 착각하지 않는다.',
    proof: 'merge · deploy · live',
  },
];

const eras = [
  {
    period: '2026.04 — 05',
    title: '명령을 만들던 시기',
    text: 'todo와 worklog 같은 반복 기록을 슬래시 커맨드로 줄였다. 자동화의 출발점은 거대한 에이전트가 아니라 귀찮은 한 단계를 없애는 일이었다.',
    note: 'single session → reusable commands',
  },
  {
    period: '2026.05 — 06',
    title: '기기를 늘리던 시기',
    text: 'Mac과 WSL, 여러 실행 엔진을 연결하며 최대 5대까지 확장했다. 속도는 올랐지만 중복 배정, 환경 차이, 결과 회수 문제가 함께 커졌다.',
    note: 'more nodes → more coordination',
  },
  {
    period: '2026.07 — 08',
    title: '복잡성을 되돌리던 시기',
    text: '팀 분할과 다중 오케스트레이션을 실험한 뒤 효과가 없는 구조는 접었다. 정책 문장보다 claim, 체크포인트, 검증 게이트 같은 강제 장치를 남겼다.',
    note: 'experiment → measure → rollback',
  },
  {
    period: '2026.09 — NOW',
    title: '작게 연결해 끝내는 시기',
    text: '현재 공개 설명의 기준은 3대의 Mac과 5종 브릿지다. 모든 엔진을 동시에 돌리지 않고, 작업마다 가용성을 확인해 한 책임 리드가 필요한 도구만 쓴다.',
    note: 'one lead → verified delivery',
  },
];

const layers = [
  {
    label: 'INPUT',
    title: '요청',
    text: '직접 대화와 Telegram이 같은 작업 입구를 공유한다.',
  },
  {
    label: 'WORKSPACE',
    title: '코드',
    text: '제품 저장소와 분리된 브랜치에서 변경을 만든다.',
  },
  {
    label: 'ENGINE',
    title: '도구',
    text: 'Cursor·Codex·Grok·Local은 고정 직급이 아니라 필요할 때 고르는 실행 수단이다.',
  },
  {
    label: 'EVIDENCE',
    title: '검증',
    text: '테스트·스크린샷·런타임 관측·라이브 URL이 완료의 근거가 된다.',
  },
  {
    label: 'MEMORY',
    title: '기록',
    text: '작업 장부·체크포인트·작업일지·노하우가 다음 작업의 시작점을 만든다.',
  },
];

const stopped = [
  {
    before: '많이 켜면 더 빠르다',
    after: '필요한 한 곳만 책임진다',
  },
  {
    before: '설정 파일이 맞으면 적용됐다',
    after: '실행 환경과 새 PID까지 본다',
  },
  {
    before: 'CI가 초록이면 배포됐다',
    after: '사용자가 받는 페이지를 확인한다',
  },
  {
    before: '완료 보고를 기억하면 된다',
    after: '관측값과 체크포인트를 남긴다',
  },
];

const fieldNotes = [
  {
    date: '2026.09.14',
    title: '설정 파일과 실행 환경은 다를 수 있다',
    text: 'plist·현재 PID의 환경·프로세스 시작 시각을 함께 봐야 설정 적용을 확정할 수 있다.',
    href: 'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/2026-09-14-launchd-config-live-env-three-way-check.md',
  },
  {
    date: '2026.09.14',
    title: '브릿지와 작업 세션은 따로 재시작한다',
    text: '메시지 운반 경로를 고치면서 대화형 세션의 문맥과 입력 버퍼까지 지우지 않는다.',
    href: 'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/2026-09-14-restart-transport-not-interactive-session.md',
  },
  {
    date: '2026.09.14',
    title: '스토어 completed와 공개 출시는 다르다',
    text: '트랙 상태와 사용자가 여는 공개 URL이 모두 맞을 때 출시 완료로 닫는다.',
    href: 'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/2026-09-14-store-console-completed-public-url-404.md',
  },
  {
    date: '2026.09.14',
    title: '비코드 작업에도 검증 영수증이 필요하다',
    text: '설정·재시작·수동 UI 작업도 관측값, 기대값, 해시로 다시 확인할 수 있게 남긴다.',
    href: 'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/2026-09-14-operational-verification-observation-hash.md',
  },
];
---

<Layout
  title="바이브코딩 작업 방식 — 마이너스베타스튜디오"
  description="강대종이 AI 코딩을 요청에서 출시까지 이어가는 현재 작업 방식. 3대의 Mac, 5종 공개 브릿지, 작업별 단일 책임과 검증 중심 운영을 소개합니다."
>
  <Fragment slot="head">
    <meta property="og:title" content="바이브코딩 작업 방식 — 마이너스베타스튜디오" />
    <meta
      property="og:description"
      content="프롬프트보다 완료 조건, 자신감보다 관측값. 요청에서 실제 출시까지 이어지는 현재의 바이브코딩 운영 방식."
    />
    <meta property="og:image" content="https://work.kangdaejong.com/og-default.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://work.kangdaejong.com/vibecoding.html" />
    <meta property="og:site_name" content="강대종 작업장" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="바이브코딩 작업 방식 — 마이너스베타스튜디오" />
    <meta
      name="twitter:description"
      content="요청을 코드로, 코드를 검증된 출시로 연결하는 1인 개발자의 현재 작업 방식."
    />
    <meta name="twitter:image" content="https://work.kangdaejong.com/og-default.png" />
    <link rel="canonical" href="https://work.kangdaejong.com/vibecoding.html" />
  </Fragment>

  <article class="vibe-page">
    <nav class="crumb" aria-label="현재 위치">
      <a href="/">작업장</a>
      <span>/</span>
      <a href="/lab/">실험실</a>
      <span>/</span>
      <span aria-current="page">바이브코딩</span>
    </nav>

    <header class="vibe-hero">
      <div class="hero-copy">
        <p class="kicker">VIBECODING / WORKING METHOD 2026</p>
        <h1>
          빨리 만드는 것보다,<br />
          <em>제대로 끝내는 방식.</em>
        </h1>
        <p class="hero-lead">
          바이브코딩은 이제 프롬프트를 잘 쓰는 기술만을 뜻하지 않습니다. 요청의 범위를 정하고,
          코드에서 직접 반복하고, 실패할 수 있는 축을 검증해 실제 사용자 표면까지 보내는
          <strong>작은 운영 체계</strong>에 가깝습니다.
        </p>
        <div class="hero-actions">
          <a class="primary-link" href="#working-loop">현재 작업 루프 보기</a>
          <a class="text-link" href="/knowhow.html/">실전 노하우 {knowhowCount}건 <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="hero-poster" aria-label="현재 바이브코딩 루프">
        <div class="poster-head">
          <span>LIVE METHOD</span>
          <span>2026.09.14</span>
        </div>
        <p>Request</p>
        <span class="poster-arrow" aria-hidden="true">↓</span>
        <p>Ground</p>
        <span class="poster-arrow" aria-hidden="true">↓</span>
        <p>Build</p>
        <span class="poster-arrow" aria-hidden="true">↓</span>
        <p>Verify</p>
        <span class="poster-arrow" aria-hidden="true">↓</span>
        <p class="poster-accent">Ship.</p>
        <small>사람이 목표를 정하고, 도구가 만들며, 증거가 완료를 결정합니다.</small>
      </aside>
    </header>

    <dl class="signal-strip" aria-label="현재 작업 방식 요약">
      {stats.map((stat) => (
        <div>
          <dd>{stat.value}</dd>
          <dt>{stat.label}</dt>
        </div>
      ))}
    </dl>

    <section class="vibe-section principles-section" aria-labelledby="principles-title">
      <div class="section-heading">
        <div>
          <p class="kicker">01 / OPERATING PRINCIPLES</p>
          <h2 id="principles-title">지금 지키는 네 가지 원칙.</h2>
        </div>
        <p>
          도구 이름은 자주 바뀌지만, 작업을 안전하게 끝내는 기준은 오래 남습니다.
        </p>
      </div>
      <div class="principle-grid">
        {principles.map((principle) => (
          <article class="principle-card" data-principle>
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section
      class="vibe-section loop-section"
      id="working-loop"
      aria-labelledby="loop-title"
    >
      <div class="loop-intro">
        <p class="kicker">02 / CURRENT LOOP</p>
        <h2 id="loop-title">요청에서 실제 출시까지.</h2>
        <p>
          각 단계는 다음 단계로 넘어가기 위한 산출물을 남깁니다. 그래서 세션이 바뀌거나 도구가
          달라져도 작업을 처음부터 다시 추측하지 않습니다.
        </p>
      </div>
      <ol class="loop-list">
        {loop.map((item) => (
          <li data-loop-step>
            <span class="loop-number">{item.step}</span>
            <div>
              <p class="loop-label">{item.label}</p>
              <h3>{item.title}</h3>
              <p class="loop-text">{item.text}</p>
              <code>{item.proof}</code>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="vibe-section era-section" aria-labelledby="era-title">
      <div class="section-heading">
        <div>
          <p class="kicker">03 / FOUR ERAS</p>
          <h2 id="era-title">늘렸다가, 줄이고, 기준을 남겼습니다.</h2>
        </div>
        <p>
          12단계 기능 연표 대신 무엇이 바뀌었고 어떤 판단이 남았는지만 네 시기로 압축했습니다.
        </p>
      </div>
      <ol class="era-grid">
        {eras.map((era, index) => (
          <li data-era>
            <div class="era-top">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <time>{era.period}</time>
            </div>
            <h3>{era.title}</h3>
            <p>{era.text}</p>
            <code>{era.note}</code>
          </li>
        ))}
      </ol>
    </section>

    <section class="vibe-section layer-section" aria-labelledby="layer-title">
      <div class="section-heading">
        <div>
          <p class="kicker">04 / CONNECTED LAYERS</p>
          <h2 id="layer-title">도구가 아니라 흐름으로 봅니다.</h2>
        </div>
        <p>
          엔진 하나가 모든 일을 하는 구조가 아닙니다. 요청·코드·도구·증거·기록이 느슨하게
          연결되고, 작업마다 필요한 층만 사용합니다.
        </p>
      </div>
      <div class="layer-board">
        {layers.map((layer, index) => (
          <article>
            <span>{layer.label}</span>
            <div class="layer-index">{String(index + 1).padStart(2, '0')}</div>
            <h3>{layer.title}</h3>
            <p>{layer.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="anti-section" aria-labelledby="anti-title">
      <div class="anti-heading">
        <p class="kicker">05 / WHAT CHANGED</p>
        <h2 id="anti-title">더 자동화한 것이 아니라,<br />잘못 믿던 것을 줄였습니다.</h2>
      </div>
      <div class="anti-list">
        {stopped.map((item) => (
          <div>
            <p><span>BEFORE</span>{item.before}</p>
            <span class="anti-arrow" aria-hidden="true">→</span>
            <p><span>NOW</span>{item.after}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="vibe-section notes-section" aria-labelledby="notes-title">
      <div class="section-heading">
        <div>
          <p class="kicker">06 / FRESH FIELD NOTES</p>
          <h2 id="notes-title">최근에 다시 확인한 것.</h2>
        </div>
        <p>
          작업 방식은 선언보다 사고와 복구에서 더 많이 바뀝니다. 최근 현장에서 다시 쓴 원칙입니다.
        </p>
      </div>
      <div class="notes-grid">
        {fieldNotes.map((note, index) => (
          <a href={note.href} target="_blank" rel="noopener">
            <div class="note-meta">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <time>{note.date}</time>
            </div>
            <h3>{note.title}</h3>
            <p>{note.text}</p>
            <b>원문 보기 <span aria-hidden="true">↗</span></b>
          </a>
        ))}
      </div>
    </section>

    <aside class="closing-block">
      <p class="kicker">THE POINT</p>
      <blockquote>
        “바이브”는 시작을 빠르게 만들고,<br />
        <strong>운영 방식은 끝을 믿을 수 있게 만듭니다.</strong>
      </blockquote>
      <div>
        <p>
          이 페이지는 2026년 9월 14일의 작업 방식입니다. 다음 변화와 실제 산출물은 작업일지와
          노하우에 계속 남깁니다.
        </p>
        <a href="/worklog/">최근 작업일지</a>
        <a href="/knowhow.html/">노하우 아카이브</a>
      </div>
    </aside>

    <footer class="vibe-footer">
      <p>내용 확인 <time datetime="2026-09-14">2026.09.14</time></p>
      <a href="/lab/">실험실로 돌아가기</a>
    </footer>
  </article>

  <style>
    .vibe-page {
      --vibe-accent: var(--accent);
      --vibe-green: var(--accent-2);
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: 88px;
      padding-top: 4px;
    }

    .vibe-page > * {
      min-width: 0;
    }

    .crumb,
    .kicker,
    .poster-head,
    .signal-strip,
    .principle-card > span,
    .loop-number,
    .loop-label,
    .loop-list code,
    .era-top,
    .era-grid code,
    .layer-board > article > span,
    .layer-index,
    .anti-list p span,
    .note-meta,
    .vibe-footer {
      font-family: var(--mono);
    }

    .crumb {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      color: var(--fg-mute);
      font-size: var(--text-badge);
    }


---
import Layout from '../layouts/Layout.astro';
import ContentCases from '../components/ContentCases.astro';
import experiments from '../data/lab-experiments.json';
import automationCases from '../data/automation-cases.json';
import knowhowIndex from '../../public/knowhow/index.json';

const knowhowCount = knowhowIndex.entries.length;
const reviewed = '2026-09-23';
const latestNotes = [...knowhowIndex.entries]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 4);
const recentCases = [
  ...automationCases.filter(item => item.id === 'wheel-feedback'),
  ...experiments.filter(item => item.id === 'free-prefilter'),
];

const stats = [
  { value: '1', label: '한 번에 해결할 문제' },
  { value: '5', label: '요청부터 확인까지 단계' },
  { value: '2', label: '근거가 있는 실제 사례' },
  { value: reviewed.slice(5).replace('-', '.'), label: '내용 확인일' },
];

const principles = [
  {
    number: '01',
    title: '프롬프트보다 완료 조건',
    text: '만들 결과와 끝났다고 판단할 조건을 함께 적는다. 코드 수정·동작 확인·공개 반영을 서로 다른 단계로 본다.',
  },
  {
    number: '02',
    title: '한 작업에는 한 책임자',
    text: '여러 도구를 쓸 수 있어도 같은 일을 동시에 선점하지 않는다. 하나의 리드가 판단과 결과 회수를 끝까지 책임진다.',
  },
  {
    number: '03',
    title: '자신감보다 관측값',
    text: '파일을 바꿨다는 말보다 실행 중인 프로세스, 테스트 결과, 실제 기기와 공개 URL에서 읽은 값을 믿는다.',
  },
  {
    number: '04',
    title: '되돌리기 어려운 일은 마지막에',
    text: '삭제·결제·발송·스토어 제출·공개 머지는 준비와 검증을 마친 뒤 승인 범위 안에서 실행한다.',
  },
];

const loop = [
  {
    step: '01',
    label: 'REQUEST',
    title: '목표와 끝을 정한다',
    text: '사용자 요청에서 결과물, 완료 조건, 제외 범위를 분리한다. 모호함이 결과를 바꿀 때만 질문한다.',
    proof: 'goal · scope · done',
  },
  {
    step: '02',
    label: 'GROUND',
    title: '현재 상태를 먼저 읽는다',
    text: '기억보다 코드, 실행 중인 환경, 최신 정책과 외부 상태를 확인한다. 오래된 전제를 작업에 들이지 않는다.',
    proof: 'code · runtime · policy',
  },
  {
    step: '03',
    label: 'BUILD',
    title: '작은 변경으로 만든다',
    text: '작업 공간을 분리하고 직접 코드에서 반복한다. 병렬화는 독립적인 부분에만 쓰고 같은 파일 경합을 피한다.',
    proof: 'branch · diff · artifact',
  },
  {
    step: '04',
    label: 'VERIFY',
    title: '문제가 생길 조건을 확인한다',
    text: '빌드만 보지 않는다. 회귀 테스트, 모바일 화면, 링크, 비밀정보, 런타임 값을 변경 위험에 맞게 검증한다.',
    proof: 'test · visual · runtime',
  },
  {
    step: '05',
    label: 'SHIP',
    title: '실제로 사용하는 곳에서 확인한다',
    text: '코드 검토와 배포가 끝나면 실제 주소나 기기에서 바뀐 동작을 확인한다. 준비된 파일과 사용자가 받는 결과를 구분한다.',
    proof: 'merge · deploy · live',
  },
];

const eras = [
  {
    period: '2026.04 — 05',
    title: '명령을 만들던 시기',
    text: 'todo와 worklog 같은 반복 기록을 슬래시 커맨드로 줄였다. 자동화의 출발점은 거대한 에이전트가 아니라 귀찮은 한 단계를 없애는 일이었다.',
    note: 'single session → reusable commands',
  },
  {
    period: '2026.05 — 06',
    title: '기기를 늘리던 시기',
    text: 'Mac과 WSL, 여러 실행 엔진을 연결하며 최대 5대까지 확장했다. 속도는 올랐지만 중복 배정, 환경 차이, 결과 회수 문제가 함께 커졌다.',
    note: 'more nodes → more coordination',
  },
  {
    period: '2026.07 — 08',
    title: '복잡성을 되돌리던 시기',
    text: '팀 분할과 다중 오케스트레이션을 실험한 뒤 효과가 없는 구조는 접었다. 정책 문장보다 claim, 체크포인트, 검증 게이트 같은 강제 장치를 남겼다.',
    note: 'experiment → measure → rollback',
  },
  {
    period: '2026.09 — NOW',
    title: '작게 연결해 끝내는 시기',
    text: '3대의 Mac과 5종 브릿지를 연결하되 작업마다 한 책임 리드가 필요한 도구만 쓴다. 9월에는 AI 판단과 무료 규칙을 비교하고, 실제 사용 피드백을 공개 변경과 검증으로 연결하는 기준을 보강했다.',
    note: 'one lead → verified delivery',
  },
];

const layers = [
  {
    label: 'INPUT',
    title: '요청',
    text: '직접 대화와 Telegram은 서로 다른 입력 경로다. 누가 요청했는지, 어떤 프로그램이 전달했는지, 어디서 실행하는지를 구분해 같은 작업 기록으로 연결한다.',
  },
  {
    label: 'WORKSPACE',
    title: '코드',
    text: '제품 저장소와 분리된 브랜치에서 변경을 만든다.',
  },
  {
    label: 'ENGINE',
    title: '도구',
    text: 'Codex·Cursor·Grok은 작업별 리드 또는 워커 후보이며 고정 직급이 아니다. Claude·Local을 포함한 브릿지 종류와 현재 작업에 배정된 엔진도 구분한다.',
  },
  {
    label: 'EVIDENCE',
    title: '검증',
    text: '테스트·스크린샷·런타임 관측·라이브 URL이 완료의 근거가 된다.',
  },
  {
    label: 'MEMORY',
    title: '기록',
    text: '작업 장부·체크포인트·작업일지·노하우가 다음 작업의 시작점을 만든다.',
  },
];

const stopped = [
  {
    before: '많이 켜면 더 빠르다',
    after: '필요한 한 곳만 책임진다',
  },
  {
    before: '설정 파일이 맞으면 적용됐다',
    after: '실행 환경과 새 PID까지 본다',
  },
  {
    before: 'CI가 초록이면 배포됐다',
    after: '사용자가 받는 페이지를 확인한다',
  },
  {
    before: '완료 보고를 기억하면 된다',
    after: '관측값과 체크포인트를 남긴다',
  },
];

const earlierNotes = [
  {
    date: '2026.09.14',
    title: '설정 파일과 실행 환경은 다를 수 있다',
    text: 'plist·현재 PID의 환경·프로세스 시작 시각을 함께 봐야 설정 적용을 확정할 수 있다.',
    href: 'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/2026-09-14-launchd-config-live-env-three-way-check.md',
  },
  {
    date: '2026.09.14',
    title: '브릿지와 작업 세션은 따로 재시작한다',
    text: '메시지 운반 경로를 고치면서 대화형 세션의 문맥과 입력 버퍼까지 지우지 않는다.',
    href: 'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/2026-09-14-restart-transport-not-interactive-session.md',
  },
  {
    date: '2026.09.14',
    title: '스토어 completed와 공개 출시는 다르다',
    text: '트랙 상태와 사용자가 여는 공개 URL이 모두 맞을 때 출시 완료로 닫는다.',
    href: 'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/2026-09-14-store-console-completed-public-url-404.md',
  },
  {
    date: '2026.09.14',
    title: '비코드 작업에도 검증 영수증이 필요하다',
    text: '설정·재시작·수동 UI 작업도 관측값, 기대값, 해시로 다시 확인할 수 있게 남긴다.',
    href: 'https://github.com/ssamssae/daejong-page/blob/main/public/knowhow/2026-09-14-operational-verification-observation-hash.md',
  },
];
---

<Layout
  title="바이브코딩 작업 방식 — 마이너스베타스튜디오"
  description="2026-09-23 확인한 강대종의 AI 개발 방식. 실제 사용 피드백, AI와 무료 규칙 비교, 구현·배포·사용자 확인을 구분하는 과정과 공개 근거를 소개합니다."
>
  <Fragment slot="head">
    <meta property="og:title" content="바이브코딩 작업 방식 — 마이너스베타스튜디오" />
    <meta
      property="og:description"
      content="프롬프트보다 완료 조건, 자신감보다 관측값. 요청에서 실제 출시까지 이어지는 현재의 바이브코딩 운영 방식."
    />
    <meta property="og:image" content="https://kangdaejong.com/brand/current/social.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://work.kangdaejong.com/vibecoding.html" />
    <meta property="og:site_name" content="강대종 작업장" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="바이브코딩 작업 방식 — 마이너스베타스튜디오" />
    <meta
      name="twitter:description"
      content="요청을 코드로, 코드를 검증된 출시로 연결하는 1인 개발자의 현재 작업 방식."
    />
    <meta name="twitter:image" content="https://kangdaejong.com/brand/current/social.png" />
    <link rel="canonical" href="https://work.kangdaejong.com/vibecoding.html" />
  </Fragment>

  <article class="vibe-page">
    <nav class="crumb" aria-label="현재 위치">
      <a href="/">작업장</a>
      <span>/</span>
      <a href="/lab/">실험실</a>
      <span>/</span>
      <span aria-current="page">바이브코딩</span>
    </nav>

    <header class="vibe-hero">
      <div class="hero-copy">
        <p class="kicker">VIBECODING / WORKING METHOD 2026</p>
        <h1>
          말로 시작해서,<br />
          <em>쓸 수 있는 결과까지.</em>
        </h1>
        <p class="hero-lead">
          이 작업장에서 바이브코딩은 말로 요청하고 AI와 코드를 고쳐 가는 개발 방식입니다.
          사람은 만들 이유와 완료 기준을 정하고, AI는 구현과 확인을 돕습니다.
          마지막에는 <strong>사용자가 실제로 보는 결과</strong>까지 확인합니다.
        </p>
        <div class="hero-actions">
          <a class="primary-link" href="#start-small">작은 작업 하나 시작하기</a>
          <a class="text-link" href="/knowhow.html/">실전 노하우 {knowhowCount}건 <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="hero-poster" aria-label="현재 바이브코딩 루프">
        <div class="poster-head">
          <span>작업을 끝내는 순서</span>
          <time datetime={reviewed}>{reviewed.replaceAll('-', '.')}</time>
        </div>
        <p>요청 정하기</p>
        <span class="poster-arrow" aria-hidden="true">↓</span>
        <p>현재 상태 읽기</p>
        <span class="poster-arrow" aria-hidden="true">↓</span>
        <p>작게 만들기</p>
        <span class="poster-arrow" aria-hidden="true">↓</span>
        <p>직접 확인하기</p>
        <span class="poster-arrow" aria-hidden="true">↓</span>
        <p class="poster-accent">사용자에게 반영하기</p>
        <small>사람이 목표를 정하고, 도구가 만들며, 증거가 완료를 결정합니다.</small>
      </aside>
    </header>

    <dl class="signal-strip" aria-label="현재 작업 방식 요약">
      {stats.map((stat) => (
        <div>
          <dd>{stat.value}</dd>
          <dt>{stat.label}</dt>
        </div>
      ))}
    </dl>



    <nav class="page-jumps" aria-label="바이브코딩 본문 목차">
      <a href="#start-small">처음 시작하기</a><a href="#working-loop">작업 순서</a><a href="#real-cases">실제 사례</a><a href="#done-check">완료 체크</a><a href="#background">작업장 변천사</a>
    </nav>
    <section class="start-small" id="start-small" aria-labelledby="start-title">
      <div class="section-heading"><div><p class="kicker">START SMALL</p><h2 id="start-title">첫 요청은 작고 구체적으로.</h2></div><p>버튼 하나, 입력창 하나처럼 직접 결과를 확인할 수 있는 문제부터 시작합니다. 아래는 실제 의뢰가 아닌 따라 써볼 수 있는 예시입니다.</p></div>
      <div class="request-comparison">
        <article><h3>이렇게만 말하면</h3><blockquote>“할 일 앱 좀 좋게 만들어줘.”</blockquote><p>누가 쓰는지, 어느 화면이 불편한지, 무엇이 되면 끝인지 알 수 없어 결과가 엇갈리기 쉽습니다.</p></article>
        <article><h3>확인할 수 있게 바꾸면</h3><blockquote>“휴대폰에서 할 일을 추가할 때 키보드가 등록 버튼을 가립니다. 입력한 글을 유지하면서 등록할 수 있게 고쳐주세요. 작은 화면과 긴 한글 제목으로 확인하고, 로그인·저장 방식은 바꾸지 마세요.”</blockquote><p>대상·문제·원하는 동작·확인 조건·제외 범위가 생겼습니다. AI가 만든 결과도 같은 조건으로 검토할 수 있습니다.</p></article>
      </div>
      <details class="request-template"><summary>내 작업에 맞춰 쓸 요청 틀</summary><pre>누가, 어디에서 쓰나요:
지금 불편한 동작:
바라는 결과:
끝났다고 판단할 확인 방법:
바꾸지 않을 것:
공개 반영이 필요한지:</pre><p>모르는 항목은 “현재 상태를 먼저 확인해 주세요”라고 적어도 됩니다. 불확실한 내용을 사실처럼 채울 필요는 없습니다.</p></details>
    </section>


    <section class="vibe-section principles-section" aria-labelledby="principles-title">
      <div class="section-heading">
        <div>
          <p class="kicker">01 / OPERATING PRINCIPLES</p>
          <h2 id="principles-title">지금 지키는 네 가지 원칙.</h2>
        </div>
        <p>
          도구 이름은 자주 바뀌지만, 작업을 안전하게 끝내는 기준은 오래 남습니다.
        </p>
      </div>
      <div class="principle-grid">
        {principles.map((principle) => (
          <article class="principle-card" data-principle>
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section
      class="vibe-section loop-section"
      id="working-loop"
      aria-labelledby="loop-title"
    >
      <div class="loop-intro">
        <p class="kicker">02 / CURRENT LOOP</p>
        <h2 id="loop-title">요청에서 실제 출시까지.</h2>
        <p>
          각 단계는 다음 단계로 넘어가기 위한 산출물을 남깁니다. 그래서 세션이 바뀌거나 도구가
          달라져도 작업을 처음부터 다시 추측하지 않습니다.
        </p>
      </div>
      <ol class="loop-list">
        {loop.map((item) => (
          <li data-loop-step>
            <span class="loop-number">{item.step}</span>
            <div>
              <p class="loop-label">{item.label}</p>
              <h3>{item.title}</h3>
              <p class="loop-text">{item.text}</p>
              <code>{item.proof}</code>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div id="real-cases">
    <ContentCases title="최근 작업에서 달라진 두 가지 판단" intro="2026-09-21 비교 실험과 9월 23일 공개 변경을 연결했습니다. 원래 측정일과 한계를 유지하며, 이번 페이지 갱신에서 새 실험을 한 것은 아닙니다." cases={recentCases}/>
    </div>

    <details class="background-details" id="background"><summary>작업장 구조와 변천사 읽기</summary><div class="background-body">
    <aside class="current-context" aria-labelledby="current-context-title">
      <h2 id="current-context-title">현재 구성과 실제 가동은 다릅니다.</h2>

---
import ArticleFrame from "../../components/ArticleFrame.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const posts = await getCollection("worklog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout
  title={`${post.data.title} — 작업일지`}
  description={post.data.summary ?? post.data.title}
>
  <ArticleFrame
    title={post.data.title}
    summary={post.data.summary}
    date={post.data.date}
    version={post.data.version}
    headings={headings}
    label="작업일지"
    base="/worklog/"><Content /></ArticleFrame
  >
  <aside class="store-footer">
    <p class="store-footer__line">
      이 작업장에서 만든 앱 —
      <a
        href="https://play.google.com/store/apps/details?id=com.daejongkang.simple_memo_app"
        >메모요</a
      >
      (<a
        href="https://play.google.com/store/apps/details?id=com.daejongkang.simple_memo_app"
        >Play</a
      >·<a href="https://apps.apple.com/kr/app/id6762068073">App Store</a>) ·
      <a
        href="https://play.google.com/store/apps/details?id=com.daejongkang.hanjul"
        >한줄일기</a
      >
      (<a
        href="https://play.google.com/store/apps/details?id=com.daejongkang.hanjul"
        >Play</a
      >·<a href="https://apps.apple.com/kr/app/id6764308678">App Store</a>)
    </p>
  </aside>

  <style>
    .store-footer {
      max-width: 900px;
      margin: 32px 0 0 auto;
      border-top: 1px solid var(--border);
      padding-top: 20px;
      font-size: 13px;
      line-height: 1.9;
    }
  </style>
</Layout>

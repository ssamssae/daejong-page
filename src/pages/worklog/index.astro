---
import Archive from "../../components/Archive.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const sortedPosts = (await getCollection("worklog")).sort(
  (a, b) =>
    b.data.date.localeCompare(a.data.date) ||
    (b.data.version ?? "").localeCompare(a.data.version ?? ""),
);
const seenDates = new Set<string>();
const posts = sortedPosts.filter((post) => {
  if (seenDates.has(post.data.date)) return false;
  seenDates.add(post.data.date);
  return true;
});
---

<Layout
  title="작업일지 — 마이너스베타스튜디오"
  description="매일 만든 것, 고친 것, 막힌 것. 작은 진전과 시행착오를 차곡차곡 남깁니다."
>
  <Archive
    posts={posts}
    base="/worklog"
    title="작업일지"
    eyebrow="SMALL STEPS, EVERY DAY"
    description="매일 만든 것, 고친 것, 막힌 것. 작은 진전과 시행착오를 차곡차곡 남깁니다."
  />
</Layout>
